contract ScratchGVN
{
  method_resolution_order: (
    algopy._contract.Contract,
  )
  
  subroutine examples.hello_world.scratch_gvn.ScratchGVN.approval_program(): bool
  {
    n: uint64 = 42u
    examples.hello_world.scratch_gvn.scratch_gvn_demo(n)
    return true
  }
  
  subroutine examples.hello_world.scratch_gvn.ScratchGVN.clear_state_program(): bool
  {
    return true
  }
  
  subroutine algopy._contract.Contract.__init__(): void
  {
  }
}

subroutine scratch_gvn_demo(n: uint64): uint64
{
  a: uint64 = n
  b: uint64 = n
  while (true) {
    if (n == 0u) {
      a: uint64 = n
      b: uint64 = n
    }
    log(itob(a))
    log(itob(b))
    b: uint64 = a
    a: uint64 = b
    if (n == 0u) {
      break
    }
  }
  return a + b
}

contract HelloWorldContract
{
  method_resolution_order: (
    algopy._contract.Contract,
  )
  
  subroutine examples.hello_world.contract.HelloWorldContract.approval_program(): bool
  {
    name: bytes = txnas<ApplicationArgs>(0u)
    log(hex<"48656C6C6F2C20"> + name)
    return true
  }
  
  subroutine examples.hello_world.contract.HelloWorldContract.clear_state_program(): bool
  {
    return true
  }
  
  subroutine algopy._contract.Contract.__init__(): void
  {
  }
}