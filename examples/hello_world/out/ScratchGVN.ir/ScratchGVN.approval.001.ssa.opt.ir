main examples.hello_world.scratch_gvn.ScratchGVN.approval_program:
    block@0: // L5
        examples.hello_world.scratch_gvn.scratch_gvn_demo(42u)
        return 1u

subroutine examples.hello_world.scratch_gvn.scratch_gvn_demo(n: uint64) -> uint64:
    block@0: // L14
        goto block@1
    block@1: // while_top_L18
        let a#3: uint64 = φ(n#0 <- block@0, a#2 <- block@6)
        let tmp%0#0: bool = (! n#0)
        goto n#0 ? block@4 : block@3
    block@3: // if_body_L20
        goto block@4
    block@4: // after_if_else_L19
        let a#2: uint64 = φ(a#3 <- block@1, n#0 <- block@3)
        let tmp%1#0: bytes = (itob a#2)
        (log tmp%1#0)
        (log tmp%1#0)
        goto n#0 ? block@6 : block@5
    block@5: // if_body_L27
        let (a#5: uint64, b#5: uint64) = (a#2, a#2)
        let tmp%4#0: uint64 = (+ a#5 b#5)
        return tmp%4#0
    block@6: // after_if_else_L26
        goto block@1