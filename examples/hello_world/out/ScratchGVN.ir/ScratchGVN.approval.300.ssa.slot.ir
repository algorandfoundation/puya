main examples.hello_world.scratch_gvn.ScratchGVN.approval_program:
    block@0: // L5
        let tmp%0#0: uint64 = (txn NumAppArgs)
        let tmp%1#0: uint64 = examples.hello_world.scratch_gvn.scratch_gvn_demo(tmp%0#0)
        let tmp%2#0: uint64 = (txn NumAppArgs)
        let tmp%3#0: uint64 = (txn NumAppArgs)
        let tmp%4#0: uint64 = (+ tmp%2#0 tmp%3#0)
        let tmp%5#0: bool = (== tmp%1#0 tmp%4#0)
        (assert tmp%5#0)
        return 1u

subroutine examples.hello_world.scratch_gvn.scratch_gvn_demo(n: uint64) -> uint64:
    block@1: // while_top_L17
        let tmp%1#0: bytes = (itob n#0)
        (log tmp%1#0)
        (log tmp%1#0)
        goto n#0 ? block@1 : block@5
    block@5: // if_body_L26
        let tmp%4#0: uint64 = (+ n#0 n#0)
        return tmp%4#0