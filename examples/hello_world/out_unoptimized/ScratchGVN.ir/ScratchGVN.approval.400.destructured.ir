main examples.hello_world.scratch_gvn.ScratchGVN.approval_program:
    block@0: // L5
        let tmp%0#0: uint64 = (txn NumAppArgs)
        let tmp%1#0: uint64 = examples.hello_world.scratch_gvn.scratch_gvn_demo(tmp%0#0)
        let tmp%2#0: uint64 = (txn NumAppArgs)
        let tmp%3#0: uint64 = (txn NumAppArgs)
        let tmp%4#0: uint64 = (+ tmp%2#0 tmp%3#0)
        let tmp%5#0: bool = (== tmp%1#0 tmp%4#0)
        (assert tmp%5#0)
        return 1u

subroutine examples.hello_world.scratch_gvn.scratch_gvn_demo(n: uint64) -> uint64:
    block@0: // L13
        let a#0: uint64 = n#0
        let b#0: uint64 = n#0
        goto block@1
    block@1: // while_top_L17
        let b#5: uint64 = b#0
        let a#5: uint64 = a#0
        goto 1u ? block@2 : block@7
    block@2: // while_body_L18
        let tmp%0#0: bool = (== n#0 0u)
        goto tmp%0#0 ? block@3 : block@4
    block@3: // if_body_L19
        let a#0: uint64 = n#0
        let b#0: uint64 = n#0
        goto block@4
    block@4: // after_if_else_L18
        let tmp%1#0: bytes = (itob a#0)
        (log tmp%1#0)
        let tmp%2#0: bytes = (itob b#0)
        (log tmp%2#0)
        let b#0: uint64 = a#0
        let a#0: uint64 = b#0
        let tmp%3#0: bool = (== n#0 0u)
        goto tmp%3#0 ? block@5 : block@6
    block@5: // if_body_L26
        let b#5: uint64 = b#0
        let a#5: uint64 = a#0
        goto block@7
    block@6: // after_if_else_L25
        goto block@1
    block@7: // after_while_L17
        let tmp%4#0: uint64 = (+ a#5 b#5)
        return tmp%4#0