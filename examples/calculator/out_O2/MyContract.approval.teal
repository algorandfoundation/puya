#pragma version 11
#pragma typetrack false

// examples.calculator.contract.MyContract.approval_program() -> uint64:
main:
    intcblock 1 3 10 0
    bytecblock 0x30313233343536373839
    pushbytes ""
    txn NumAppArgs
    dup
    bnz main_else_body@2
    pop
    intc_3 // 0
    dupn 2
    bury 3
    intc_3 // 0
    itob
    dup
    log
    log

main_after_if_else@3:
    dig 2
    intc_0 // 1
    ==
    dup
    bz main_else_body@6
    dig 1
    dig 3
    +
    cover 2

main_after_inlined_examples.calculator.contract.MyContract.do_calc@13:
    swap
    callsub itoa
    swap
    bz main_else_body@16
    pushbytes 0x202b20

main_after_inlined_examples.calculator.contract.MyContract.op@23:
    concat
    uncover 2
    callsub itoa
    concat
    pushbytes 0x203d20
    concat
    swap
    callsub itoa
    concat
    log
    intc_0 // 1
    return

main_else_body@16:
    dig 3
    pushint 2
    ==
    bz main_else_body@18

main_if_body@17:
    pushbytes 0x202d20
    b main_after_inlined_examples.calculator.contract.MyContract.op@23

main_else_body@18:
    dig 3
    intc_1 // 3
    ==
    bz main_else_body@20
    pushbytes 0x202a20
    b main_after_inlined_examples.calculator.contract.MyContract.op@23

main_else_body@20:
    dig 3
    pushint 4
    ==
    bz main_if_body@17
    pushbytes 0x202f2f20
    b main_after_inlined_examples.calculator.contract.MyContract.op@23

main_else_body@6:
    dig 3
    pushint 2
    ==
    bz main_else_body@8
    dig 1
    dig 3
    -
    cover 2
    b main_after_inlined_examples.calculator.contract.MyContract.do_calc@13

main_else_body@8:
    dig 3
    intc_1 // 3
    ==
    bz main_else_body@10
    dig 1
    dig 3
    *
    cover 2
    b main_after_inlined_examples.calculator.contract.MyContract.do_calc@13

main_else_body@10:
    dig 3
    pushint 4
    ==
    assert // unknown operation
    dig 1
    dig 3
    /
    cover 2
    b main_after_inlined_examples.calculator.contract.MyContract.do_calc@13

main_else_body@2:
    intc_1 // 3
    ==
    assert // Expected 3 args
    txna ApplicationArgs 0
    btoi
    bury 1
    txna ApplicationArgs 1
    txna ApplicationArgs 2
    dig 1
    log
    dup
    log
    swap
    btoi
    swap
    btoi
    swap
    b main_after_if_else@3


// examples.calculator.contract.itoa(i: uint64) -> bytes:
itoa:
    proto 1 1
    frame_dig -1
    intc_2 // 10
    <
    bz itoa_after_if_else@2
    bytec_0 // 0x30313233343536373839
    frame_dig -1
    intc_0 // 1
    extract3
    retsub

itoa_after_if_else@2:
    frame_dig -1
    intc_2 // 10
    /
    callsub itoa
    frame_dig -1
    intc_2 // 10
    %
    bytec_0 // 0x30313233343536373839
    swap
    intc_0 // 1
    extract3
    concat
    retsub
