#pragma version 11
#pragma typetrack false

// nested_scc_collapse.NestedSccCollapse.approval_program() -> uint64:
main:
    intcblock 0 1
    txn NumAppArgs
    dup
    intc_0 // 0

main_while_top@1:
    dup
    dig 2
    <
    bz main_after_while@6
    intc_0 // 0
    swap

main_while_top@3:
    dig 1
    dig 3
    <
    bz main_after_while@5
    swap
    intc_1 // 1
    +
    swap
    dig 2
    bury 4
    b main_while_top@3

main_after_while@5:
    bury 1
    intc_1 // 1
    +
    b main_while_top@1

main_after_while@6:
    pop
    dig 1
    ==
    return
