// Op                                               Stack (out)
// nested_scc_collapse.NestedSccCollapse.approval_program() -> uint64:
subroutine main:
    main_block@0:
        txn NumAppArgs                              n#0
        x-store n#0                                 (𝕏) n#0 |
        int 0                                       (𝕏) n#0 | 0
        x-store i#0                                 (𝕏) n#0,i#0 |
        b main_while_top@1                          (𝕏) n#0,i#0 |

    main_while_top@1:                               (𝕏) n#0,i#0 |
        x-load-copy i#0                             (𝕏) n#0,i#0 | i#0 (copy)
        x-load-copy n#0                             (𝕏) n#0,i#0 | i#0 (copy),n#0 (copy)
        <                                           (𝕏) n#0,i#0 | tmp%1#0
        bz main_after_while@6 ; b main_while_body@2 (𝕏) n#0,i#0 |

    main_while_body@2:                              (𝕏) n#0,i#0 |
        int 0                                       (𝕏) n#0,i#0 | 0
        x-store j#0                                 (𝕏) n#0,j#0,i#0 |
        b main_while_top@3                          (𝕏) n#0,j#0,i#0 |

    main_while_top@3:                               (𝕏) n#0,j#0,i#0 |
        x-load-copy j#0                             (𝕏) n#0,j#0,i#0 | j#0 (copy)
        x-load-copy n#0                             (𝕏) n#0,j#0,i#0 | j#0 (copy),n#0 (copy)
        <                                           (𝕏) n#0,j#0,i#0 | tmp%2#0
        bz main_after_while@5 ; b main_while_body@4 (𝕏) n#0,j#0,i#0 |

    main_while_body@4:                              (𝕏) n#0,j#0,i#0 |
        x-load j#0                                  (𝕏) n#0,i#0 | j#0
        int 1                                       (𝕏) n#0,i#0 | j#0,1
        +                                           (𝕏) n#0,i#0 | j#0
        x-store j#0                                 (𝕏) n#0,j#0,i#0 |
        b main_while_top@3                          (𝕏) n#0,j#0,i#0 |

    main_after_while@5:                             (𝕏) n#0,j#0,i#0 |
        x-load j#0                                  (𝕏) n#0,i#0 | j#0
        pop 1                                       (𝕏) n#0,i#0 |
        x-load i#0                                  (𝕏) n#0 | i#0
        int 1                                       (𝕏) n#0 | i#0,1
        +                                           (𝕏) n#0 | i#0
        x-store i#0                                 (𝕏) n#0,i#0 |
        b main_while_top@1                          (𝕏) n#0,i#0 |

    main_after_while@6:                             (𝕏) n#0,i#0 |
        int 1                                       (𝕏) n#0,i#0 | 1
        return                                      (𝕏) n#0,i#0 |


