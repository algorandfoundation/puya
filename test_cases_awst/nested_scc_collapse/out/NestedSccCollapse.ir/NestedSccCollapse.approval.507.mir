// Op                                               Stack (out)
// nested_scc_collapse.NestedSccCollapse.approval_program() -> uint64:
subroutine main:
    declare uint64 j#0
    main_block@0:                                   (𝕗) j#0 |
        txn NumAppArgs                              (𝕗) j#0 | n#0
        f-store n#0                                 (𝕗) j#0,n#0 |
        int 0                                       (𝕗) j#0,n#0 | i#0
        f-store i#0                                 (𝕗) j#0,n#0,i#0 |
        b main_while_top@1                          (𝕗) j#0,n#0,i#0 |

    main_while_top@1:                               (𝕗) j#0,n#0,i#0 |
        f-load i#0                                  (𝕗) j#0,n#0,i#0 | i#0
        f-load n#0                                  (𝕗) j#0,n#0,i#0 | i#0,n#0
        <                                           (𝕗) j#0,n#0,i#0 | tmp%1#0
        bz main_after_while@6 ; b main_while_body@2 (𝕗) j#0,n#0,i#0 |

    main_while_body@2:                              (𝕗) j#0,n#0,i#0 |
        int 0                                       (𝕗) j#0,n#0,i#0 | j#0
        f-store j#0                                 (𝕗) j#0,n#0,i#0 |
        b main_while_top@3                          (𝕗) j#0,n#0,i#0 |

    main_while_top@3:                               (𝕗) j#0,n#0,i#0 |
        f-load j#0                                  (𝕗) j#0,n#0,i#0 | j#0
        f-load n#0                                  (𝕗) j#0,n#0,i#0 | j#0,n#0
        <                                           (𝕗) j#0,n#0,i#0 | tmp%2#0
        bz main_after_while@5 ; b main_while_body@4 (𝕗) j#0,n#0,i#0 |

    main_while_body@4:                              (𝕗) j#0,n#0,i#0 |
        f-load j#0                                  (𝕗) j#0,n#0,i#0 | j#0
        int 1                                       (𝕗) j#0,n#0,i#0 | j#0,1
        +                                           (𝕗) j#0,n#0,i#0 | j#0
        f-store j#0                                 (𝕗) j#0,n#0,i#0 |
        b main_while_top@3                          (𝕗) j#0,n#0,i#0 |

    main_after_while@5:                             (𝕗) j#0,n#0,i#0 |
        f-load i#0                                  (𝕗) j#0,n#0,i#0 | i#0
        int 1                                       (𝕗) j#0,n#0,i#0 | i#0,1
        +                                           (𝕗) j#0,n#0,i#0 | i#0
        f-store i#0                                 (𝕗) j#0,n#0,i#0 |
        b main_while_top@1                          (𝕗) j#0,n#0,i#0 |

    main_after_while@6:                             (𝕗) j#0,n#0,i#0 |
        int 1                                       (𝕗) j#0,n#0,i#0 | 1
        return                                      (𝕗) j#0,n#0,i#0 |


