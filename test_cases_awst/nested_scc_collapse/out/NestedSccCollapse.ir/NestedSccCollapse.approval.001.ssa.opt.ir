main nested_scc_collapse.NestedSccCollapse.approval_program:
    block@0: // L5
        let n#0: uint64 = (txn NumAppArgs)
        let i#0: uint64 = 0u
        goto block@1
    block@1: // while_top_L12
        let i#1: uint64 = φ(i#0 <- block@0, i#3 <- block@5)
        let v#2: uint64 = φ(n#0 <- block@0, v#3 <- block@5)
        let tmp%1#0: bool = (< i#1 n#0)
        goto tmp%1#0 ? block@2 : block@6
    block@2: // while_body_L13
        let j#0: uint64 = 0u
        goto block@3
    block@3: // while_top_L14
        let j#1: uint64 = φ(j#0 <- block@2, j#2 <- block@4)
        let v#3: uint64 = φ(v#2 <- block@2, n#0 <- block@4)
        let tmp%2#0: bool = (< j#1 n#0)
        goto tmp%2#0 ? block@4 : block@5
    block@4: // while_body_L15
        let j#2: uint64 = (+ j#1 1u)
        goto block@3
    block@5: // after_while_L14
        let i#3: uint64 = (+ i#1 1u)
        goto block@1
    block@6: // after_while_L12
        let tmp%5#0: bool = (== v#2 n#0)
        return tmp%5#0