// Op                                                                        Stack (out)
// algopy.arc4.ARC4Contract.approval_program() -> uint64:
subroutine main:
    main_block@0:
        txn NumAppArgs                                                       tmp%0#1
        v-store tmp%0#1
        v-load tmp%0#1                                                       tmp%0#1
        bz main___algopy_default_create@5 ; b main_abi_routing@2

    main_abi_routing@2:
        txna ApplicationArgs 0                                               tmp%2#0
        v-store tmp%2#0
        method run(uint64,uint64,uint64,uint64)uint64                        Method(run(uint64,uint64,uint64,uint64)uint64)
        v-load tmp%2#0                                                       Method(run(uint64,uint64,uint64,uint64)uint64),tmp%2#0
        match main_run_route@3 ; b main_switch_case_next@4

    main_run_route@3:
        txn OnCompletion                                                     tmp%3#0
        v-store tmp%3#0
        v-load tmp%3#0                                                       tmp%3#0
        !                                                                    tmp%4#0
        v-store tmp%4#0
        txn ApplicationID                                                    tmp%5#0
        v-store tmp%5#0
        v-load tmp%4#0                                                       tmp%4#0
        v-load tmp%5#0                                                       tmp%4#0,tmp%5#0
        &&                                                                   tmp%7#0
        v-store tmp%7#0
        v-load tmp%7#0                                                       tmp%7#0
        assert
        callsub run
        b main_switch_case_next@4

    main_switch_case_next@4:
        err

    main___algopy_default_create@5:
        txn OnCompletion                                                     tmp%8#0
        v-store tmp%8#0
        v-load tmp%8#0                                                       tmp%8#0
        !                                                                    tmp%9#0
        v-store tmp%9#0
        txn ApplicationID                                                    tmp%10#0
        v-store tmp%10#0
        v-load tmp%10#0                                                      tmp%10#0
        !                                                                    tmp%11#0
        v-store tmp%11#0
        v-load tmp%9#0                                                       tmp%9#0
        v-load tmp%11#0                                                      tmp%9#0,tmp%11#0
        &&                                                                   tmp%12#0
        v-store tmp%12#0
        v-load tmp%12#0                                                      tmp%12#0
        assert
        int 1                                                                1
        return


// stub.branchy_alternating(a: uint64, b: uint64, c: uint64, n: uint64) -> uint64:
subroutine branchy_alternating:
    branchy_alternating_block@0:                                             (𝕡) a#0,b#0,c#0,n#0 |
        int 0                                                                (𝕡) a#0,b#0,c#0,n#0 | 0
        v-store s#0                                                          (𝕡) a#0,b#0,c#0,n#0 |
        int 0                                                                (𝕡) a#0,b#0,c#0,n#0 | 0
        v-store i#0                                                          (𝕡) a#0,b#0,c#0,n#0 |
        p-load c#0                                                           (𝕡) a#0,b#0,c#0,n#0 | c#0 (copy)
        bz branchy_alternating_else_body@2 ; b branchy_alternating_if_body@1 (𝕡) a#0,b#0,c#0,n#0 |

    branchy_alternating_if_body@1:                                           (𝕡) a#0,b#0,c#0,n#0 |
        p-load a#0                                                           (𝕡) a#0,b#0,c#0,n#0 | a#0 (copy)
        p-load b#0                                                           (𝕡) a#0,b#0,c#0,n#0 | a#0 (copy),b#0 (copy)
        |                                                                    (𝕡) a#0,b#0,c#0,n#0 | x#1
        v-store x#1                                                          (𝕡) a#0,b#0,c#0,n#0 |
        b branchy_alternating_block@3                                        (𝕡) a#0,b#0,c#0,n#0 |

    branchy_alternating_else_body@2:                                         (𝕡) a#0,b#0,c#0,n#0 |
        p-load b#0                                                           (𝕡) a#0,b#0,c#0,n#0 | b#0 (copy)
        p-load a#0                                                           (𝕡) a#0,b#0,c#0,n#0 | b#0 (copy),a#0 (copy)
        |                                                                    (𝕡) a#0,b#0,c#0,n#0 | x#1
        v-store x#1                                                          (𝕡) a#0,b#0,c#0,n#0 |
        b branchy_alternating_block@3                                        (𝕡) a#0,b#0,c#0,n#0 |

    branchy_alternating_block@3:                                             (𝕡) a#0,b#0,c#0,n#0 |
        v-load i#0                                                           (𝕡) a#0,b#0,c#0,n#0 | i#0
        p-load n#0                                                           (𝕡) a#0,b#0,c#0,n#0 | i#0,n#0 (copy)
        <                                                                    (𝕡) a#0,b#0,c#0,n#0 | tmp%5#0
        v-store tmp%5#0                                                      (𝕡) a#0,b#0,c#0,n#0 |
        v-load tmp%5#0                                                       (𝕡) a#0,b#0,c#0,n#0 | tmp%5#0
        bz branchy_alternating_else_body@5 ; b branchy_alternating_if_body@4 (𝕡) a#0,b#0,c#0,n#0 |

    branchy_alternating_if_body@4:                                           (𝕡) a#0,b#0,c#0,n#0 |
        v-load s#0                                                           (𝕡) a#0,b#0,c#0,n#0 | s#0
        v-load i#0                                                           (𝕡) a#0,b#0,c#0,n#0 | s#0,i#0
        +                                                                    (𝕡) a#0,b#0,c#0,n#0 | s#0
        v-store s#0                                                          (𝕡) a#0,b#0,c#0,n#0 |
        v-load i#0                                                           (𝕡) a#0,b#0,c#0,n#0 | i#0
        int 1                                                                (𝕡) a#0,b#0,c#0,n#0 | i#0,1
        +                                                                    (𝕡) a#0,b#0,c#0,n#0 | i#0
        v-store i#0                                                          (𝕡) a#0,b#0,c#0,n#0 |
        b branchy_alternating_block@3                                        (𝕡) a#0,b#0,c#0,n#0 |

    branchy_alternating_else_body@5:                                         (𝕡) a#0,b#0,c#0,n#0 |
        v-load x#1                                                           (𝕡) a#0,b#0,c#0,n#0 | x#1
        v-load x#1                                                           (𝕡) a#0,b#0,c#0,n#0 | x#1,x#1
        +                                                                    (𝕡) a#0,b#0,c#0,n#0 | tmp%8#0
        v-store tmp%8#0                                                      (𝕡) a#0,b#0,c#0,n#0 |
        v-load tmp%8#0                                                       (𝕡) a#0,b#0,c#0,n#0 | tmp%8#0
        v-load s#0                                                           (𝕡) a#0,b#0,c#0,n#0 | tmp%8#0,s#0
        +                                                                    (𝕡) a#0,b#0,c#0,n#0 | tmp%9#0
        v-store tmp%9#0                                                      (𝕡) a#0,b#0,c#0,n#0 |
        v-load tmp%9#0                                                       (𝕡) a#0,b#0,c#0,n#0 | tmp%9#0
        retsub                                                               tmp%9#0


// stub.SccVnMergedAwstContract.run[routing]() -> void:
subroutine run:
    run_block@0:
        txna ApplicationArgs 1                                               tmp%0#0
        v-store tmp%0#0
        v-load tmp%0#0                                                       tmp%0#0
        len                                                                  len%0#0
        v-store len%0#0
        v-load len%0#0                                                       len%0#0
        int 8                                                                len%0#0,8
        ==                                                                   eq%0#0
        v-store eq%0#0
        v-load eq%0#0                                                        eq%0#0
        assert // invalid number of bytes for arc4.uint64
        v-load tmp%0#0                                                       tmp%0#0
        btoi                                                                 a#0
        v-store a#0
        txna ApplicationArgs 2                                               tmp%2#0
        v-store tmp%2#0
        v-load tmp%2#0                                                       tmp%2#0
        len                                                                  len%1#0
        v-store len%1#0
        v-load len%1#0                                                       len%1#0
        int 8                                                                len%1#0,8
        ==                                                                   eq%1#0
        v-store eq%1#0
        v-load eq%1#0                                                        eq%1#0
        assert // invalid number of bytes for arc4.uint64
        v-load tmp%2#0                                                       tmp%2#0
        btoi                                                                 b#0
        v-store b#0
        txna ApplicationArgs 3                                               tmp%4#0
        v-store tmp%4#0
        v-load tmp%4#0                                                       tmp%4#0
        len                                                                  len%2#0
        v-store len%2#0
        v-load len%2#0                                                       len%2#0
        int 8                                                                len%2#0,8
        ==                                                                   eq%2#0
        v-store eq%2#0
        v-load eq%2#0                                                        eq%2#0
        assert // invalid number of bytes for arc4.uint64
        v-load tmp%4#0                                                       tmp%4#0
        btoi                                                                 c#0
        v-store c#0
        txna ApplicationArgs 4                                               tmp%6#0
        v-store tmp%6#0
        v-load tmp%6#0                                                       tmp%6#0
        len                                                                  len%3#0
        v-store len%3#0
        v-load len%3#0                                                       len%3#0
        int 8                                                                len%3#0,8
        ==                                                                   eq%3#0
        v-store eq%3#0
        v-load eq%3#0                                                        eq%3#0
        assert // invalid number of bytes for arc4.uint64
        v-load tmp%6#0                                                       tmp%6#0
        btoi                                                                 n#0
        v-store n#0
        v-load a#0                                                           a#0
        v-load b#0                                                           a#0,b#0
        v-load c#0                                                           a#0,b#0,c#0
        v-load n#0                                                           a#0,b#0,c#0,n#0
        callsub branchy_alternating                                          tmp%0#1
        v-store tmp%0#1
        v-load tmp%0#1                                                       tmp%0#1
        itob                                                                 aggregate%val_as_bytes%0#0
        v-store aggregate%val_as_bytes%0#0
        byte 0x151f7c75                                                      0x151f7c75
        v-load aggregate%val_as_bytes%0#0                                    0x151f7c75,aggregate%val_as_bytes%0#0
        concat                                                               tmp%10#0
        v-store tmp%10#0
        v-load tmp%10#0                                                      tmp%10#0
        log
        int 1                                                                1
        return


