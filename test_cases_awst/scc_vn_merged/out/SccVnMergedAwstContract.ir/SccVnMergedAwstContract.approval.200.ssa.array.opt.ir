        (assert eq%2#0) // invalid number of bytes for arc4.uint64
        let c#0: uint64 = (btoi tmp%4#0)
        let tmp%6#0: bytes = (txna ApplicationArgs 4)
        let len%3#0: uint64 = (len tmp%6#0)
        let eq%3#0: bool = (== len%3#0 8u)
