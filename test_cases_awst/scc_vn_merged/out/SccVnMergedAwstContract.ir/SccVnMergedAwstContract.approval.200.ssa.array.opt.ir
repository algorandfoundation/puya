subroutine stub.branchy_alternating(a: uint64, b: uint64, c: uint64, n: uint64) -> uint64:
    block@0: // L10
        let s#0: uint64 = 0u
        let i#0: uint64 = 0u
        goto c#0 ? block@1 : block@2
    block@1: // if_body_L1
        let x#1: uint64 = (| a#0 b#0)
        let y#1: uint64 = (| b#0 a#0)
        goto block@3
    block@2: // else_body_L1
        let x#2: uint64 = (| b#0 a#0)
        let y#2: uint64 = (| a#0 b#0)
        goto block@3
    block@3: // L1
        let i#1: uint64 = φ(i#0 <- block@1, i#0 <- block@2, i#2 <- block@4)
        let x#3: uint64 = φ(x#1 <- block@1, x#2 <- block@2, y#3 <- block@4)
        let y#3: uint64 = φ(y#1 <- block@1, y#2 <- block@2, x#3 <- block@4)
        let s#1: uint64 = φ(s#0 <- block@1, s#0 <- block@2, s#2 <- block@4)
        let tmp%5#0: bool = (< i#1 n#0)
        goto tmp%5#0 ? block@4 : block@5
    block@4: // if_body_L1
        let s#2: uint64 = (+ s#1 i#1)
        let i#2: uint64 = (+ i#1 1u)
        goto block@3
    block@5: // else_body_L1
        let tmp%8#0: uint64 = (+ x#3 y#3)
        let tmp%9#0: uint64 = (+ tmp%8#0 s#1)
        return tmp%9#0

subroutine stub.SccVnMergedAwstContract.run[routing]() -> void:
    block@0: // L5
        let tmp%0#0: bytes = (txna ApplicationArgs 1)
        let len%0#0: uint64 = (len tmp%0#0)
        let eq%0#0: bool = (== len%0#0 8u)
        (assert eq%0#0) // invalid number of bytes for arc4.uint64
        let a#0: uint64 = (btoi tmp%0#0)
        let tmp%2#0: bytes = (txna ApplicationArgs 2)
        let len%1#0: uint64 = (len tmp%2#0)
