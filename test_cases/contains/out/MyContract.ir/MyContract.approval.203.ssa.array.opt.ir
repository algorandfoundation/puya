subroutine test_cases.contains.contract.MyContract.is_in_tuple_1(x: uint64, y.0: uint64, y.1: uint64, y.2: bytes) -> bool:
    block@0: // L42
        let tmp%0#0: bool = (== x#0 y.0#0)
        goto tmp%0#0 ? block@2 : block@1
    block@1: // or_contd_L44
