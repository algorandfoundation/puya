        l-load tmp%17#0 1                                       (𝕏) tmp%5#0 | extract%1#0,tmp%17#0
        l-load extract%1#0 1                                    (𝕏) tmp%5#0 | tmp%17#0,extract%1#0
        concat                                                  (𝕏) tmp%5#0 | tmp%23#0
        // loop_else/loop_else.py:27-32
