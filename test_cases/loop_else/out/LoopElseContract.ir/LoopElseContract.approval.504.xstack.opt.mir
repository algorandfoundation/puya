    main_if_body@11:                                            (𝕏) tmp%5#0,account_index#0,arg_idx#0 |
        // loop_else/loop_else.py:29
        // op.itob(secret_index + 48)[-1],
        x-load arg_idx#0                                        (𝕏) tmp%5#0,account_index#0 | arg_idx#0
        int 48                                                  (𝕏) tmp%5#0,account_index#0 | arg_idx#0,48
        +                                                       (𝕏) tmp%5#0,account_index#0 | tmp%11#0
        itob                                                    (𝕏) tmp%5#0,account_index#0 | tmp%12#0
