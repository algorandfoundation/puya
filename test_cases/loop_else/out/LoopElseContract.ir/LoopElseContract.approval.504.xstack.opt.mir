        l-load arg_idx#0 0                                      (𝕏) arg_idx#0 | arg_idx#0
        txnas ApplicationArgs                                   (𝕏) arg_idx#0 | tmp%3#0
        byte 0x7768696c655f736563726574                         (𝕏) arg_idx#0 | tmp%3#0,0x7768696c655f736563726574
        ==                                                      (𝕏) arg_idx#0 | tmp%4#0
        bz main_after_if_else@16 ; b main_if_body@8             (𝕏) arg_idx#0 |

    main_if_body@8:                                             (𝕏) arg_idx#0 |
        // loop_else/loop_else.py:17
        // for account_index in urange(Txn.num_accounts):
        txn NumAccounts                                         (𝕏) arg_idx#0 | tmp%5#0
        x-store tmp%5#0                                         (𝕏) tmp%5#0,arg_idx#0 |
        int 0                                                   (𝕏) tmp%5#0,arg_idx#0 | account_index#0
        x-store account_index#0                                 (𝕏) tmp%5#0,account_index#0,arg_idx#0 |
        b main_for_header@9                                     (𝕏) tmp%5#0,account_index#0,arg_idx#0 |

    main_for_header@9:                                          (𝕏) tmp%5#0,account_index#0,arg_idx#0 |
        // loop_else/loop_else.py:17
        // for account_index in urange(Txn.num_accounts):
        x-load-copy account_index#0                             (𝕏) tmp%5#0,account_index#0,arg_idx#0 | account_index#0
        l-store-copy account_index#0 0                          (𝕏) tmp%5#0,account_index#0,arg_idx#0 | account_index#0,account_index#0 (copy)
        x-load-copy tmp%5#0                                     (𝕏) tmp%5#0,account_index#0,arg_idx#0 | account_index#0,account_index#0 (copy),tmp%5#0 (copy)
        <                                                       (𝕏) tmp%5#0,account_index#0,arg_idx#0 | account_index#0,continue_looping%1#0
        assert // access denied, missing secret account         (𝕏) tmp%5#0,account_index#0,arg_idx#0 | account_index#0
        // loop_else/loop_else.py:18
        // account = Txn.accounts(account_index)
        l-load account_index#0 0                                (𝕏) tmp%5#0,account_index#0,arg_idx#0 | account_index#0
        txnas Accounts                                          (𝕏) tmp%5#0,account_index#0,arg_idx#0 | account#0
        // loop_else/loop_else.py:19
        // if account == Global.zero_address:
        global ZeroAddress                                      (𝕏) tmp%5#0,account_index#0,arg_idx#0 | account#0,tmp%7#0
        l-load account#0 1                                      (𝕏) tmp%5#0,account_index#0,arg_idx#0 | tmp%7#0,account#0
        l-load tmp%7#0 1                                        (𝕏) tmp%5#0,account_index#0,arg_idx#0 | account#0,tmp%7#0
        ==                                                      (𝕏) tmp%5#0,account_index#0,arg_idx#0 | tmp%8#0
