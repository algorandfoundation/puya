        concat                                                  (𝕏) tmp%5#0,account_index#0 | tmp%17#0
        // loop_else/loop_else.py:31
        // op.itob(account_index + 48)[-1],
        x-load account_index#0                                  (𝕏) tmp%5#0 | tmp%17#0,account_index#0
        int 48                                                  (𝕏) tmp%5#0 | tmp%17#0,account_index#0,48
        +                                                       (𝕏) tmp%5#0 | tmp%17#0,tmp%19#0
        itob                                                    (𝕏) tmp%5#0 | tmp%17#0,tmp%20#0
