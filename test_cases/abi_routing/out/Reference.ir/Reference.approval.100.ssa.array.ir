subroutine _puya_lib.arc4.dynamic_array_read_dynamic_element(array: bytes, index: uint64) -> bytes:
    block@0: // L134
        let array_head_and_tail#0: bytes = ((extract 2 0) array#0)
        let array_length#0: uint64 = (extract_uint16 array#0 0u)
        let tmp%0#1: uint64 = (* index#0 2u)
        let item_start_offset#0: uint64 = (extract_uint16 array_head_and_tail#0 tmp%0#1)
        let end_of_tail#0: uint64 = (len array_head_and_tail#0)
        let next_index#0: uint64 = (+ index#0 1u)
        let tmp%4#0: uint64 = (* next_index#0 2u)
        let next_item_offset#0: uint64 = (extract_uint16 array_head_and_tail#0 tmp%4#0)
        let is_before_end#0: uint64 = (- array_length#0 next_index#0)
        let item_end_offset#0: uint64 = (select end_of_tail#0 next_item_offset#0 is_before_end#0)
        let tmp%8#0: bytes = (substring3 array_head_and_tail#0 item_start_offset#0 item_end_offset#0)
        return tmp%8#0

