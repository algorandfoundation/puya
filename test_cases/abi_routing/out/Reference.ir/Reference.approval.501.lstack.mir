// test_cases.abi_routing.contract.Reference.opt_into_asset[routing]() -> void:
subroutine opt_into_asset:
    opt_into_asset_block@0:
        // abi_routing/contract.py:92
        // @arc4.abimethod
        txna ApplicationArgs 1                                                                     value#0
        l-load-copy value#0 0                                                                      value#0,value#0 (copy)
        len                                                                                        value#0,len%0#0
        l-load len%0#0 0                                                                           value#0,len%0#0
        int 8                                                                                      value#0,len%0#0,8
        ==                                                                                         value#0,eq%0#0
        l-load eq%0#0 0                                                                            value#0,eq%0#0
        assert // invalid number of bytes for arc4.uint64                                          value#0
        // abi_routing/contract.py:92
        // @arc4.abimethod
        l-load value#0 0                                                                           value#0
        btoi                                                                                       asset#0
        // abi_routing/contract.py:95
        // assert op.Txn.sender == op.Global.creator_address, "Only creator can opt in to ASA"
        txn Sender                                                                                 asset#0,tmp%0#1
        global CreatorAddress                                                                      asset#0,tmp%0#1,tmp%1#1
        l-load tmp%0#1 1                                                                           asset#0,tmp%1#1,tmp%0#1
        l-load tmp%1#1 1                                                                           asset#0,tmp%0#1,tmp%1#1
        ==                                                                                         asset#0,tmp%2#0
        l-load tmp%2#0 0                                                                           asset#0,tmp%2#0
        assert // Only creator can opt in to ASA                                                   asset#0
        // abi_routing/contract.py:97
        // assert not self.asa, "ASA already opted in"
        int 0                                                                                      asset#0,0
        byte "asa"                                                                                 asset#0,0,"asa"
        app_global_get_ex                                                                          asset#0,maybe_value%0#0,maybe_exists%0#0
        l-load maybe_exists%0#0 0                                                                  asset#0,maybe_value%0#0,maybe_exists%0#0
        assert // check self.asa exists                                                            asset#0,maybe_value%0#0
        l-load maybe_value%0#0 0                                                                   asset#0,maybe_value%0#0
        !                                                                                          asset#0,tmp%3#0
        l-load tmp%3#0 0                                                                           asset#0,tmp%3#0
        assert // ASA already opted in                                                             asset#0
        // abi_routing/contract.py:99
        // self.asa = asset
        byte "asa"                                                                                 asset#0,"asa"
        l-load-copy asset#0 1                                                                      asset#0,"asa",asset#0 (copy)
        app_global_put                                                                             asset#0
        // abi_routing/contract.py:102
        // op.ITxnCreate.begin()
        itxn_begin                                                                                 asset#0
        // abi_routing/contract.py:103
        // op.ITxnCreate.set_type_enum(TransactionType.AssetTransfer)
        int axfer                                                                                  asset#0,axfer
        itxn_field TypeEnum                                                                        asset#0
        // abi_routing/contract.py:104
        // op.ITxnCreate.set_fee(UInt64(0))  # cover fee with outer txn
        int 0                                                                                      asset#0,0
        itxn_field Fee                                                                             asset#0
        // abi_routing/contract.py:105
        // op.ITxnCreate.set_asset_receiver(op.Global.current_application_address)
        global CurrentApplicationAddress                                                           asset#0,tmp%4#0
        l-load tmp%4#0 0                                                                           asset#0,tmp%4#0
        itxn_field AssetReceiver                                                                   asset#0
        // abi_routing/contract.py:106
        // op.ITxnCreate.set_xfer_asset(asset)
        l-load asset#0 0                                                                           asset#0
        itxn_field XferAsset
        // abi_routing/contract.py:107
        // op.ITxnCreate.submit()
        itxn_submit
        // abi_routing/contract.py:92
        // @arc4.abimethod
        int 1                                                                                      1
        return


// test_cases.abi_routing.contract.Reference.with_transactions[routing]() -> void:
subroutine with_transactions:
    with_transactions_block@0:
        // abi_routing/contract.py:109
        // @arc4.abimethod
        txna ApplicationArgs 1                                                                     value#0
        l-load-copy value#0 0                                                                      value#0,value#0 (copy)
        len                                                                                        value#0,len%0#0
        l-load len%0#0 0                                                                           value#0,len%0#0
        int 8                                                                                      value#0,len%0#0,8
        ==                                                                                         value#0,eq%0#0
        l-load eq%0#0 0                                                                            value#0,eq%0#0
        assert // invalid number of bytes for arc4.uint64                                          value#0
        // abi_routing/contract.py:109
        // @arc4.abimethod
        l-load value#0 0                                                                           value#0
        btoi                                                                                       asset#0
        txna ApplicationArgs 2                                                                     asset#0,value#0
        l-load-copy value#0 0                                                                      asset#0,value#0,value#0 (copy)
        len                                                                                        asset#0,value#0,len%0#0
        l-load len%0#0 0                                                                           asset#0,value#0,len%0#0
        int 8                                                                                      asset#0,value#0,len%0#0,8
        ==                                                                                         asset#0,value#0,eq%0#0
        l-load eq%0#0 0                                                                            asset#0,value#0,eq%0#0
        assert // invalid number of bytes for arc4.uint64                                          asset#0,value#0
        // abi_routing/contract.py:109
        // @arc4.abimethod
        txn GroupIndex                                                                             asset#0,value#0,tmp%3#0
        l-load tmp%3#0 0                                                                           asset#0,value#0,tmp%3#0
        int 1                                                                                      asset#0,value#0,tmp%3#0,1
        -                                                                                          asset#0,value#0,pay#0
        l-load-copy pay#0 0                                                                        asset#0,value#0,pay#0,pay#0 (copy)
        gtxns TypeEnum                                                                             asset#0,value#0,pay#0,gtxn_type%0#0
        l-load gtxn_type%0#0 0                                                                     asset#0,value#0,pay#0,gtxn_type%0#0
        int pay                                                                                    asset#0,value#0,pay#0,gtxn_type%0#0,pay
        ==                                                                                         asset#0,value#0,pay#0,gtxn_type_matches%0#0
        l-load gtxn_type_matches%0#0 0                                                             asset#0,value#0,pay#0,gtxn_type_matches%0#0
        assert // transaction type is pay                                                          asset#0,value#0,pay#0
        txna ApplicationArgs 3                                                                     asset#0,value#0,pay#0,value#2
        l-load-copy value#2 0                                                                      asset#0,value#0,pay#0,value#2,value#2 (copy)
        len                                                                                        asset#0,value#0,pay#0,value#2,len%0#0
        l-load len%0#0 0                                                                           asset#0,value#0,pay#0,value#2,len%0#0
        int 8                                                                                      asset#0,value#0,pay#0,value#2,len%0#0,8
        ==                                                                                         asset#0,value#0,pay#0,value#2,eq%0#0
        l-load eq%0#0 0                                                                            asset#0,value#0,pay#0,value#2,eq%0#0
        assert // invalid number of bytes for arc4.uint64                                          asset#0,value#0,pay#0,value#2
        // abi_routing/contract.py:117
        // assert self.asa == asset, "is correct asset"
        int 0                                                                                      asset#0,value#0,pay#0,value#2,0
        byte "asa"                                                                                 asset#0,value#0,pay#0,value#2,0,"asa"
        app_global_get_ex                                                                          asset#0,value#0,pay#0,value#2,maybe_value%0#0,maybe_exists%0#0
        l-load maybe_exists%0#0 0                                                                  asset#0,value#0,pay#0,value#2,maybe_value%0#0,maybe_exists%0#0
        assert // check self.asa exists                                                            asset#0,value#0,pay#0,value#2,maybe_value%0#0
        l-load maybe_value%0#0 0                                                                   asset#0,value#0,pay#0,value#2,maybe_value%0#0
        l-load asset#0 4                                                                           value#0,pay#0,value#2,maybe_value%0#0,asset#0
        ==                                                                                         value#0,pay#0,value#2,tmp%0#1
        l-load tmp%0#1 0                                                                           value#0,pay#0,value#2,tmp%0#1
        assert // is correct asset                                                                 value#0,pay#0,value#2
        // abi_routing/contract.py:118
        // assert an_int.as_uint64() == 1, "is correct int"
        l-load value#0 2                                                                           pay#0,value#2,value#0
        btoi                                                                                       pay#0,value#2,tmp%1#1
        l-load tmp%1#1 0                                                                           pay#0,value#2,tmp%1#1
        int 1                                                                                      pay#0,value#2,tmp%1#1,1
        ==                                                                                         pay#0,value#2,tmp%2#1
        l-load tmp%2#1 0                                                                           pay#0,value#2,tmp%2#1
        assert // is correct int                                                                   pay#0,value#2
        // abi_routing/contract.py:119
        // assert pay.receiver == op.Global.current_application_address, "is payment to app"
        l-load pay#0 1                                                                             value#2,pay#0
        gtxns Receiver                                                                             value#2,tmp%3#1
        global CurrentApplicationAddress                                                           value#2,tmp%3#1,tmp%4#1
        l-load tmp%3#1 1                                                                           value#2,tmp%4#1,tmp%3#1
        l-load tmp%4#1 1                                                                           value#2,tmp%3#1,tmp%4#1
        ==                                                                                         value#2,tmp%5#0
        l-load tmp%5#0 0                                                                           value#2,tmp%5#0
        assert // is payment to app                                                                value#2
        // abi_routing/contract.py:120
        // assert another_int.as_uint64() == 2, "is correct int"
        l-load value#2 0                                                                           value#2
        btoi                                                                                       tmp%6#0
        l-load tmp%6#0 0                                                                           tmp%6#0
        int 2                                                                                      tmp%6#0,2
        ==                                                                                         tmp%7#0
        l-load tmp%7#0 0                                                                           tmp%7#0
        assert // is correct int
        // abi_routing/contract.py:109
        // @arc4.abimethod
        int 1                                                                                      1
        return


// test_cases.abi_routing.contract.Reference.compare_assets[routing]() -> void:
subroutine compare_assets:
    compare_assets_block@0:
        // abi_routing/contract.py:122
        // @arc4.abimethod
        txna ApplicationArgs 1                                                                     value#0
        l-load-copy value#0 0                                                                      value#0,value#0 (copy)
        len                                                                                        value#0,len%0#0
        l-load len%0#0 0                                                                           value#0,len%0#0
        int 8                                                                                      value#0,len%0#0,8
        ==                                                                                         value#0,eq%0#0
        l-load eq%0#0 0                                                                            value#0,eq%0#0
        assert // invalid number of bytes for arc4.uint64                                          value#0
        // abi_routing/contract.py:122
        // @arc4.abimethod
        l-load value#0 0                                                                           value#0
        btoi                                                                                       asset_a#0
        txna ApplicationArgs 2                                                                     asset_a#0,value#0
        l-load-copy value#0 0                                                                      asset_a#0,value#0,value#0 (copy)
        len                                                                                        asset_a#0,value#0,len%0#0
        l-load len%0#0 0                                                                           asset_a#0,value#0,len%0#0
        int 8                                                                                      asset_a#0,value#0,len%0#0,8
        ==                                                                                         asset_a#0,value#0,eq%0#0
        l-load eq%0#0 0                                                                            asset_a#0,value#0,eq%0#0
        assert // invalid number of bytes for arc4.uint64                                          asset_a#0,value#0
        // abi_routing/contract.py:122
        // @arc4.abimethod
        l-load value#0 0                                                                           asset_a#0,value#0
        btoi                                                                                       asset_a#0,asset_b#0
        // abi_routing/contract.py:124
        // assert asset_a == asset_b, "asset a == b"
        l-load asset_a#0 1                                                                         asset_b#0,asset_a#0
        l-load asset_b#0 1                                                                         asset_a#0,asset_b#0
        ==                                                                                         tmp%0#1
        l-load tmp%0#1 0                                                                           tmp%0#1
        assert // asset a == b
        // abi_routing/contract.py:122
        // @arc4.abimethod
        int 1                                                                                      1
        return


