        l-load maybe_exists%0#0 0                                                                  int_from_local#0,bytes_from_local#0,maybe_value%0#0,maybe_exists%0#0
        assert // check self.local_uint exists for account                                         int_from_local#0,bytes_from_local#0,maybe_value%0#0
