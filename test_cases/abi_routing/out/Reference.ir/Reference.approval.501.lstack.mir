        // result = UInt64(1) + a.as_uint64()
        l-load value#0 0                                                                           value#0
        btoi                                                                                       tmp%0#1
        int 1                                                                                      tmp%0#1,1
        l-load tmp%0#1 1                                                                           1,tmp%0#1
        +                                                                                          result#0
        // abi_routing/contract.py:64
        // return arc4.UInt8(result)
        l-load result#0 0                                                                          result#0
        itob                                                                                       aggregate%val_as_bytes%0#0
        l-load-copy aggregate%val_as_bytes%0#0 0                                                   aggregate%val_as_bytes%0#0,aggregate%val_as_bytes%0#0 (copy)
        bitlen                                                                                     aggregate%val_as_bytes%0#0,aggregate%bitlen%0#0
        l-load aggregate%bitlen%0#0 0                                                              aggregate%val_as_bytes%0#0,aggregate%bitlen%0#0
        int 8                                                                                      aggregate%val_as_bytes%0#0,aggregate%bitlen%0#0,8
        <=                                                                                         aggregate%val_as_bytes%0#0,aggregate%no_overflow%0#0
        l-load aggregate%no_overflow%0#0 0                                                         aggregate%val_as_bytes%0#0,aggregate%no_overflow%0#0
        assert // overflow                                                                         aggregate%val_as_bytes%0#0
        l-load aggregate%val_as_bytes%0#0 0                                                        aggregate%val_as_bytes%0#0
        extract 7 1                                                                                aggregate%uint8%0#0
        // abi_routing/contract.py:50-61
        // @arc4.abimethod(
        //     allow_actions=[
        //         "NoOp",
        //         OnCompleteAction.OptIn,
        //         "CloseOut",
        //         OnCompleteAction.UpdateApplication,
        //         OnCompleteAction.DeleteApplication,
        //     ],
        //     name="all_the_things",
        //     create="allow",
        //     readonly=True,
        // )
        byte 0x151f7c75                                                                            aggregate%uint8%0#0,0x151f7c75
        l-load aggregate%uint8%0#0 1                                                               0x151f7c75,aggregate%uint8%0#0
        concat                                                                                     tmp%2#0
        l-load tmp%2#0 0                                                                           tmp%2#0
        log
        int 1                                                                                      1
        return


