        txna ApplicationArgs 3                                                                     one#0,two#0,value#0
        l-load-copy value#0 0                                                                      one#0,two#0,value#0,value#0 (copy)
        len                                                                                        one#0,two#0,value#0,len%0#0
        l-load len%0#0 0                                                                           one#0,two#0,value#0,len%0#0
        int 8                                                                                      one#0,two#0,value#0,len%0#0,8
