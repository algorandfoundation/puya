#pragma version 11
#pragma typetrack false

// test_cases.stack_scheduling.contract.FrameMutateInLoopConcat.approval_program() -> uint64:
main:
    txn NumAppArgs
    pushbytes 0x
    pushint 0

main_for_header@1:
    dup
    dig 3
    <
    bz main_after_for@4
    swap
    pushbytes 0x2c
    concat
    dig 1
    txnas ApplicationArgs
    concat
    swap
    pushint 1
    +
    b main_for_header@1

main_after_for@4:
    pop
    log
    pushint 1
    return
