main test_cases.stack_scheduling.contract.CallsubScratchBarrierConcat.approval_program:
    block@0: // L147
        let tmp%0#0: bytes = (txna ApplicationArgs 0)
        ((store 0) tmp%0#0)
        let tmp%1#0: bytes = (txna ApplicationArgs 1)
        let b#0: bytes = test_cases.stack_scheduling.contract._store_slot_and_itob(tmp%1#0)
        let a#0: bytes = (load 0)
        let tmp%4#0: bytes = (concat a#0 b#0)
        (log tmp%4#0)
        return 1u

subroutine test_cases.stack_scheduling.contract._store_slot_and_itob(value: bytes) -> bytes:
    block@0: // L172
        ((store 0) value#0)
        let tmp%0#0: uint64 = (txn NumAppArgs)
        let tmp%1#0: bytes = (itob tmp%0#0)
        return tmp%1#0