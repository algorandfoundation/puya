// Op                                                   Stack (out)
// test_cases.less_simple.contract.MyContract.approval_program() -> uint64:
subroutine main:
    main_block@0:
        // less_simple/contract.py:9
        // a = UInt64(1)
        int 1                                           a#0
        x-store a#0                                     (𝕏) a#0 |
        // less_simple/contract.py:10
        // sum_of_evens = UInt64(0)
        int 0                                           (𝕏) a#0 | sum_of_evens#0
        x-store sum_of_evens#0                          (𝕏) sum_of_evens#0,a#0 |
        // less_simple/contract.py:11
        // product_of_odds = UInt64(0)
        int 0                                           (𝕏) sum_of_evens#0,a#0 | product_of_odds#0
        f-store product_of_odds#0                       (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |
        b main_while_top@1                              (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |

    main_while_top@1:                                   (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |
        // less_simple/contract.py:12
        // while a < 100:
        x-load-copy a#0                                 (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | a#0 (copy)
        int 100                                         (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | a#0 (copy),100
        <                                               (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | tmp%0#0
        bz main_after_while@13 ; b main_while_body@2    (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |

    main_while_body@2:                                  (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |
        // less_simple/contract.py:13
        // if a % 5 == 0:
        x-load-copy a#0                                 (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | a#0 (copy)
        int 5                                           (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | a#0 (copy),5
        %                                               (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | tmp%1#0
        bz main_while_top@1 ; b main_after_if_else@4    (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |

    main_after_if_else@4:                               (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |
        // less_simple/contract.py:15
        // if not a % 21:
        x-load-copy a#0                                 (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | a#0 (copy)
        int 21                                          (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | a#0 (copy),21
        %                                               (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | tmp%3#0
        bz main_after_while@13 ; b main_after_if_else@6 (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |

    main_after_if_else@6:                               (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |
        // less_simple/contract.py:17
        // if a % 2 == 0:
        x-load-copy a#0                                 (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | a#0 (copy)
        int 2                                           (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | a#0 (copy),2
        %                                               (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | tmp%5#0
        bz main_if_body@7 ; b main_else_body@8          (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |

    main_if_body@7:                                     (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |
        // less_simple/contract.py:18
        // sum_of_evens += a
        x-load sum_of_evens#0                           (𝕗) product_of_odds#0 | (𝕏) a#0 | sum_of_evens#0
        x-load-copy a#0                                 (𝕗) product_of_odds#0 | (𝕏) a#0 | sum_of_evens#0,a#0 (copy)
        +                                               (𝕗) product_of_odds#0 | (𝕏) a#0 | sum_of_evens#0
        x-store sum_of_evens#0                          (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |
        b main_after_if_else@12                         (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |

    main_else_body@8:                                   (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |
        // less_simple/contract.py:20
        // if product_of_odds == 0:
        f-load product_of_odds#0                        (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | product_of_odds#0
        bz main_if_body@9 ; b main_else_body@10         (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |

    main_if_body@9:                                     (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |
        x-load-copy a#0                                 (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | product_of_odds#0
        f-store product_of_odds#0                       (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |
        b main_after_if_else@12                         (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |

    main_else_body@10:                                  (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |
        // less_simple/contract.py:23
        // product_of_odds *= a
        f-load product_of_odds#0                        (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | product_of_odds#0
        x-load-copy a#0                                 (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | product_of_odds#0,a#0 (copy)
        *                                               (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 | product_of_odds#0
        f-store product_of_odds#0                       (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |
        b main_after_if_else@12                         (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |

    main_after_if_else@12:                              (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |
        // less_simple/contract.py:24
        // a += 1
        x-load a#0                                      (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0 | a#0
        int 1                                           (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0 | a#0,1
        +                                               (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0 | a#0
        x-store a#0                                     (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |
        b main_while_top@1                              (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |

    main_after_while@13:                                (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0,a#0 |
        x-load a#0                                      (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0 | a#0
        pop 1                                           (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0 |
        // less_simple/contract.py:25
        // return product_of_odds - sum_of_evens
        f-load product_of_odds#0                        (𝕗) product_of_odds#0 | (𝕏) sum_of_evens#0 | product_of_odds#0
        x-load sum_of_evens#0                           (𝕗) product_of_odds#0 | product_of_odds#0,sum_of_evens#0
        -                                               (𝕗) product_of_odds#0 | tmp%11#0
        return                                          (𝕗) product_of_odds#0 |


