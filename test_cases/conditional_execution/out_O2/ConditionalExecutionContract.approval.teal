#pragma version 11
#pragma typetrack false

// test_cases.conditional_execution.contract.ConditionalExecutionContract.approval_program() -> uint64:
main:
    intcblock 0 1
    bytecblock "did_execute_b" "did_execute_a"
    txn ApplicationID
    bnz main_after_if_else@2
    bytec_1 // "did_execute_a"
    intc_0 // 0
    app_global_put
    bytec_0 // "did_execute_b"
    intc_0 // 0
    app_global_put

main_after_if_else@2:
    bytec_1 // "did_execute_a"
    intc_1 // 1
    app_global_put
    intc_0 // 0
    bytec_0 // "did_execute_b"
    app_global_get_ex
    assert // check self.did_execute_b exists
    bnz main_bool_false@9
    intc_1 // 1

main_bool_merge@10:
    assert
    bytec_0 // "did_execute_b"
