    bytec_1 // "did_execute_a"
    intc_1 // 1
    app_global_put
    bytec_0 // "did_execute_b"
    intc_1 // 1
    app_global_put
    intc_0 // 0
    bytec_1 // "did_execute_a"
    app_global_get_ex
    assert // check self.did_execute_a exists
    bz main_bool_false@17
    intc_0 // 0
    bytec_0 // "did_execute_b"
    app_global_get_ex
    assert // check self.did_execute_b exists
    bz main_bool_false@17
    intc_1 // 1

