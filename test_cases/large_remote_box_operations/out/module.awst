subroutine inc_array(arr: arc4.dynamic_array<uint64>, inc: uint64): arc4.dynamic_array<uint64>
{
  new: arc4.dynamic_array<uint64> = arr.copy()
  for idx in range(0u, new.length, 1u) {
    new[idx] += inc
  }
  return new
}

