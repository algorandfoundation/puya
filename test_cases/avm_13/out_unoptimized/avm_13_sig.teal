#pragma version 13
#pragma typetrack false

// test_cases.avm_13.contract.avm_13_sig() -> uint64:
main:
    b main_block@0

main_block@0:
    // avm_13/contract.py:6
    // assert op.sha512(b"") != op.sha512(b"a")
    pushbytes 0x
    sha512
    pushbytes 0x61
    sha512
    !=
    assert
    // avm_13/contract.py:7
    // scalar = op.bzero(32)
    pushint 32
    bzero
    // avm_13/contract.py:8
    // bn = op.poseidon2(op.Poseidon2Configurations.BN254t2, scalar)
    dup
    poseidon2 BN254t2
    cover 1
    // avm_13/contract.py:9
    // bls = op.poseidon2(op.Poseidon2Configurations.BLS12_381t2, scalar)
    poseidon2 BLS12_381t2
    // avm_13/contract.py:10
    // assert bn != bls
    dig 1
    !=
    assert
    // avm_13/contract.py:11
    // return bn.length
    len
    return
