subroutine test_cases.avm_13.contract.Contract.test_app_box_ops[routing]() -> void:
    block@0: // L49
        let app#0: uint64 = (global CurrentApplicationID)
        let tmp%1#0: bool = (app_box_create app#0 0x6278 8u)
        (assert tmp%1#0)
        let tmp%2#0: bytes = (bzero 8u)
        (app_box_put app#0 0x6278 tmp%2#0)
        let (value#0: bytes, exists#0: bool) = (app_box_get app#0 0x6278)
        (assert exists#0)
        let tmp%6#0: bool = (== value#0 tmp%2#0)
        (assert tmp%6#0)
        (app_box_replace app#0 0x6278 0u 0xff)
        let tmp%7#0: bytes = (app_box_extract app#0 0x6278 0u 1u)
        let tmp%8#0: bool = (== tmp%7#0 0xff)
        (assert tmp%8#0)
        (app_box_splice app#0 0x6278 1u 3u 0x616263)
        (app_box_resize app#0 0x6278 4u)
