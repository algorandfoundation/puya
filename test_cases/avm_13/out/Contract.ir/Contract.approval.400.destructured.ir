        let tmp%3#0: bool = (! tmp%2#0)
        (assert tmp%3#0)
        let tmp%4#0: uint64 = (txn ApplicationID)
        (assert tmp%4#0)
        let tmp%6#0: bytes = (txna ApplicationArgs 0)
        switch tmp%6#0 {method "test_new_ops()void" => block@4, method "test_poseidon2()void" => block@5, method "test_app_params()void" => block@6, method "test_app_box_ops()void" => block@7, method "test_block()void" => block@8, * => block@11}
