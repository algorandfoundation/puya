        goto block@11
    block@8: // test_block_route_L67
        test_cases.avm_13.contract.Contract.test_block[routing]()
        goto block@11
    block@11: // after_if_else_L14
        fail
    block@12: // __algopy_default_create_L1
        let tmp%7#0: uint64 = (txn OnCompletion)
        let tmp%8#0: bool = (! tmp%7#0)
        let tmp%9#0: uint64 = (txn ApplicationID)
        let tmp%10#0: bool = (! tmp%9#0)
        let tmp%11#0: bool = (&& tmp%8#0 tmp%10#0)
        (assert tmp%11#0)
        exit 1u

subroutine test_cases.avm_13.contract.Contract.test_new_ops[routing]() -> void:
    block@0: // L15
