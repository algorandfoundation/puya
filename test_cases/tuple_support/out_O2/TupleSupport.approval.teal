// test_cases.tuple_support.tuple_support.add_three_values(values.0: uint64, values.1: uint64, values.2: uint64) -> uint64:
add_three_values:
    proto 3 1
    intc_0 // 0
    frame_dig -3
    intc_0 // 0

add_three_values_for_body@1:
