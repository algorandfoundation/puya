#pragma version 11
#pragma typetrack false

// test_cases.tuple_support.tuple_support.TupleSupport.approval_program() -> uint64:
main:
    intcblock 1 0 2 3
    bytecblock "state"
    txn ApplicationID
    bnz main_after_if_else@2
    bytec_0 // "state"
    intc_1 // 0
    app_global_put

main_after_if_else@2:
    pushints 101 102 103
    callsub add_three_values
    itob
    log
    intc_0 // 1
    intc_2 // 2
    addw
    bytec_0 // "state"
    dig 1
    app_global_put
    dig 1
    !
    assert // overflow!
    pushbytes 0x48656c6c6f2c20776f726c6421
    log
    pushint 18446744073709551615
    dup
    addw
    uncover 2
    addw
    uncover 2
    uncover 3
    addw
    uncover 3
    addw
    cover 2
    addw
    swap
    !
    assert // is such a thing even possible? 👽
    itob
    log
    itob
    log
    itob
    log
    pushbytes 0x
    intc_1 // 0

main_for_header@24:
    dup
    pushint 5
    <
    bz main_after_for@27
    swap
    pushbytes 0x6e61
    concat
    swap
    intc_0 // 1
    +
    b main_for_header@24

main_after_for@27:
    pop
    log
    intc_0 // 1
    intc_2 // 2
    intc_3 // 3
    callsub add_three_values
    pushint 6
    ==
    assert
    pushbytes "non_empty_tuple called"
    log
    pushbytes "not empty"
    log
    pushbytes "get_uint_with_side_effect called"
    log
    pushbytes "not empty2"
    log
    intc_3 // 3
    return


// test_cases.tuple_support.tuple_support.add_three_values(values.0: uint64, values.1: uint64, values.2: uint64) -> uint64:
add_three_values:
    proto 3 1
    intc_1 // 0
    dup
    frame_dig -3

add_three_values_for_body@1:
    +
    swap
    switch add_three_values_for_header_1@3 add_three_values_for_header_2@4
    retsub

add_three_values_for_header_2@4:
    intc_2 // 2
    swap
    frame_dig -1
    b add_three_values_for_body@1

add_three_values_for_header_1@3:
    intc_0 // 1
    swap
    frame_dig -2
    b add_three_values_for_body@1
