subroutine test_cases.intrinsics.simplifications.Simplifications.select_neq[routing]() -> void:
    block@0: // L5
        let tmp%0#0: bytes = (txna ApplicationArgs 1)
        let len%0#0: uint64 = (len tmp%0#0)
        let eq%0#0: bool = (== len%0#0 8u)
        (assert eq%0#0) // invalid number of bytes for arc4.uint64
        let x#0: uint64 = (btoi tmp%0#0)
        let tmp%0#1: uint64 = (!= x#0 0u)
        let aggregate%val_as_bytes%0#0: bytes[8] = (itob tmp%0#1)
        let tmp%4#0: bytes = (concat 0x151f7c75 aggregate%val_as_bytes%0#0)
        (log tmp%4#0)
        exit 1u

subroutine test_cases.intrinsics.simplifications.Simplifications.chained_extract[routing]() -> void:
    block@0: // L11
        let tmp%0#0: bytes = (txna ApplicationArgs 1)
