        goto block@14
    block@10: // biguint_add_oversized_route_L38
        test_cases.intrinsics.simplifications.Simplifications.biguint_add_oversized[routing]()
        goto block@14
    block@11: // biguint_add_double_oversized_route_L44
        test_cases.intrinsics.simplifications.Simplifications.biguint_add_double_oversized[routing]()
        goto block@14
    block@14: // after_if_else_L4
        fail
    block@15: // __algopy_default_create_L1
        let tmp%7#0: uint64 = (txn OnCompletion)
        let tmp%8#0: bool = (! tmp%7#0)
        let tmp%9#0: uint64 = (txn ApplicationID)
        let tmp%10#0: bool = (! tmp%9#0)
        let tmp%11#0: bool = (&& tmp%8#0 tmp%10#0)
        (assert tmp%11#0)
