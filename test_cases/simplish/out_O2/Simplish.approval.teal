#pragma version 11
#pragma typetrack false

// test_cases.simplish.contract.Simplish.approval_program() -> uint64:
main:
    intcblock 1 0 100000 2 314159 628318
    bytecblock "counter" 0x30313233343536373839
    pushbytes ""
    txn ApplicationID
    bnz main_after_if_else@2
    bytec_0 // "counter"
    intc_1 // 0
    app_global_put

main_after_if_else@2:
    txn ApplicationID
    bnz main_after_if_else@4

main_if_body@3:
    intc_0 // 1
    return

main_after_if_else@4:
    txn OnCompletion
    txn Sender
    txn OnCompletion
    pushint 4 // UpdateApplication
    ==
    bnz main_if_body@6
    dig 1
    pushint 5 // DeleteApplication
    ==
    bz main_after_if_else@9

main_if_body@6:
    swap
    pushint 5 // DeleteApplication
    ==
    bz main_after_if_else@8
    intc_1 // 0
    bytec_0 // "counter"
    app_global_get_ex
    assert // check self.counter exists
    callsub itoa
    pushbytes 0x4920776173207573656420
    swap
    concat
    pushbytes 0x2074696d65287329206265666f726520492064696564
    concat
    log

main_after_if_else@8:
    global CreatorAddress
    ==
    return

main_after_if_else@9:
    dig 1
    intc_0 // OptIn
    ==
    bz main_after_if_else@13
    popn 2
    txn NumAppArgs
    bz main_if_body@3
    intc_1 // 0
    pushbytes "name"
    txna ApplicationArgs 0
    app_local_put
    b main_if_body@3

main_after_if_else@13:
    swap
    bz main_after_if_else@15
    err

main_after_if_else@15:
    txn NumAppArgs
    dup
    bz main_else_body@17
    bury 1
    txna ApplicationArgs 0
    dup
    uncover 2
    intc_3 // 2
    ==
    assert // insufficient arguments
    txna ApplicationArgs 1
    btoi
    swap
    intc_0 // 1
    bury 4
    pushbytes 0x636972636c655f61726561
    ==
    bz main_else_body@29
    bury 1
    intc_3 // 2
    exp
    intc 4 // 314159
    *
    intc_2 // 100000
    /
    callsub itoa

main_after_if_else@36:
    dig 1
    swap

main_after_if_else@24:
    log
    pushbytes "Incrementing counter!"
    log
    intc_1 // 0
    bytec_0 // "counter"
    app_global_get_ex
    assert // check self.counter exists
    intc_0 // 1
    +
    bytec_0 // "counter"
    swap
    app_global_put
    return

main_else_body@29:
    dig 1
    pushbytes 0x636972636c655f63697263756d666572656e6365
    ==
    bz main_else_body@31
    bury 1
    intc 5 // 628318
    *
    intc_2 // 100000
    /
    callsub itoa
    b main_after_if_else@36

main_else_body@31:
    swap
    pushbytes 0x636972636c655f7265706f7274
    ==
    bz main_else_body@33
    dup
    intc_3 // 2
    exp
    intc 4 // 314159
    *
    intc_2 // 100000
    /
    dig 1
    intc 5 // 628318
    *
    intc_2 // 100000
    /
    uncover 2
    callsub itoa
    pushbytes 0x417070726f78696d617465206172656120616e642063697263756d666572656e6365206f6620636972636c6520776974682072616469757320
    swap
    concat
    pushbytes 0x203d20
    concat
    uncover 2
    callsub itoa
    concat
    pushbytes 0x2c20
    concat
    swap
    callsub itoa
    concat
    b main_after_if_else@36

main_else_body@33:
    pop
    intc_1 // 0
    bury 1
    pushbytes 0x756e6b6e6f776e206d6574686f64206e616d65
    b main_after_if_else@36

main_else_body@17:
    pop
    txn NumAssets
    intc_0 // 1
    ==
    bz main_else_body@22
    intc_1 // 0
    asset_holding_get AssetBalance
    bnz main_else_body@20
    pop
    pushbytes 0x596f7520646f206e6f74206861766520616e79206f6620746865206173736574

main_after_if_else@21:
    intc_0 // 1
    swap
    b main_after_if_else@24

main_else_body@20:
    callsub itoa
    pushbytes 0x596f7520686176652061737365742062616c616e63653a20
    swap
    concat
    b main_after_if_else@21

main_else_body@22:
    pop
    intc_1 // 0
    pushbytes 0x6e6f7420656e6f756768206170702061726773206f7220666f726569676e20617373657473
    b main_after_if_else@24


// test_cases.simplish.contract.itoa(i: uint64) -> bytes:
itoa:
    proto 1 1
    frame_dig -1
    pushint 10
    <
    bz itoa_after_if_else@2
    bytec_1 // 0x30313233343536373839
    frame_dig -1
    intc_0 // 1
    extract3
    retsub

itoa_after_if_else@2:
    frame_dig -1
    pushint 10
    /
    callsub itoa
    frame_dig -1
    pushint 10
    %
    bytec_1 // 0x30313233343536373839
    swap
    intc_0 // 1
    extract3
    concat
    retsub
