#pragma version 11
#pragma typetrack false
#pragma autosalt true

// test_cases.logic_signature.lsig_args_simple.args_simple() -> uint64:
main:
    intcblock 0 1 2 10
    pushbytes ""
    b main_block@0

main_block@0:
    // logic_signature/lsig_args_simple.py:6
    // arg0: UInt64,
    arg_0
    dup
    len
    pushint 8
    ==
    assert // invalid number of bytes for uint64
    btoi
    dup
    // logic_signature/lsig_args_simple.py:7
    // pay: gtxn.PaymentTransaction,
    txn GroupIndex
    intc_2 // 2
    -
    dup
    gtxns TypeEnum
    intc_1 // pay
    ==
    assert // transaction type is pay
    cover 1
    // logic_signature/lsig_args_simple.py:8
    // arg1: Bytes,
    arg_1
    dup
    intc_0 // 0
    extract_uint16 // on error: invalid array length header
    intc_1 // 1
    *
    intc_2 // 2
    +
    dig 1
    len
    ==
    assert // invalid number of bytes for bytes
    extract 2 0
    dup
    cover 3
    // logic_signature/lsig_args_simple.py:9
    // arg2: bool,
    arg_2
    dup
    len
    intc_1 // 1
    ==
    assert // invalid number of bytes for bool
    intc_0 // 0
    getbit
    dup
    cover 2
    cover 4
    // logic_signature/lsig_args_simple.py:10
    // app_call: gtxn.ApplicationCallTransaction,
    txn GroupIndex
    intc_1 // 1
    -
    dup
    gtxns TypeEnum
    pushint 6 // appl
    ==
    assert // transaction type is appl
    cover 2
    // logic_signature/lsig_args_simple.py:12-13
    // # verify args match raw op.arg values (gtxn args consume no positions in the args array)
    // assert arg0 == arc4.UInt64.from_bytes(op.arg(0)).native
    intc_0 // 0
    args
    btoi
    dig 4
    ==
    assert
    // logic_signature/lsig_args_simple.py:14
    // assert arg1 == arc4.DynamicBytes.from_bytes(op.arg(1)).native
    intc_1 // 1
    args
    extract 2 0
    ==
    assert
    // logic_signature/lsig_args_simple.py:15
    // assert arg2 == arc4.Bool(op.btoi(op.arg(2)) != 0)
    intc_2 // 2
    args
    btoi
    intc_0 // 0
    !=
    pushbytes 0x00
    intc_0 // 0
    uncover 2
    setbit
    intc_0 // 0
    getbit
    ==
    assert
    // logic_signature/lsig_args_simple.py:17-19
    // # gtxn args bind to the transactions immediately preceding the signed one,
    // # in declaration order
    // assert pay.group_index == Txn.group_index - 2
    uncover 2
    gtxns GroupIndex
    txn GroupIndex
    intc_2 // 2
    -
    ==
    assert
    // logic_signature/lsig_args_simple.py:20
    // assert app_call.group_index == Txn.group_index - 1
    gtxns GroupIndex
    txn GroupIndex
    intc_1 // 1
    -
    ==
    assert
    // logic_signature/lsig_args_simple.py:22-23
    // # mutate all
    // if arg0 < 10:
    intc_3 // 10
    <
    bz main_after_if_else@2
    b main_if_body@1

main_if_body@1:
    // logic_signature/lsig_args_simple.py:24
    // arg0 = UInt64(10)
    intc_3 // 10
    bury 3
    b main_after_if_else@2

main_after_if_else@2:
    // logic_signature/lsig_args_simple.py:25
    // arg1 = arg1 + b"suffix"
    dig 1
    pushbytes 0x737566666978
    concat
    dup
    bury 3
    // logic_signature/lsig_args_simple.py:26
    // arg2 = not arg2
    dig 1
    !
    cover 1
    // logic_signature/lsig_args_simple.py:28-29
    // # assert all
    // assert arg0 >= 10
    dig 4
    dup
    cover 2
    intc_3 // 10
    >=
    assert
    // logic_signature/lsig_args_simple.py:30
    // assert arg1.length > 0
    len
    intc_0 // 0
    >
    assert
    bury 5
    // logic_signature/lsig_args_simple.py:32-33
    // # some random cross-arg operations
    // if arg2:
    bz main_after_if_else@4
    b main_if_body@3

main_if_body@3:
    // logic_signature/lsig_args_simple.py:34
    // arg0 += arg1.length
    dig 1
    len
    dig 3
    +
    bury 4
    b main_after_if_else@4

main_after_if_else@4:
    // logic_signature/lsig_args_simple.py:35
    // return arg0
    dig 3
    return
