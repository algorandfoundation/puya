    // def test_uint64_double_negated(a: UInt64, b: UInt64) -> None:
    proto 2 0
    // gvn/negated_comparisons.py:65
    // assert a < b
    frame_dig -2
    frame_dig -1
    <
    dup
    assert
    // gvn/negated_comparisons.py:66
    // neg = not (a < b)
    !
    // gvn/negated_comparisons.py:67
    // assert not neg
    !
    assert
    retsub


