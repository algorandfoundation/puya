main algopy.arc4.ARC4Contract.approval_program:
    block@0: // L1
        let tmp%0#1: uint64 = (txn NumAppArgs)
        goto tmp%0#1 ? block@2 : block@5
    block@2: // abi_routing_L4
        let tmp%2#0: bytes = (txna ApplicationArgs 0)
        switch tmp%2#0 {method "run(uint64,uint64)uint64" => block@3, * => block@4}
    block@3: // run_route_L5
        let tmp%3#0: uint64 = (txn OnCompletion)
        let tmp%4#0: bool = (! tmp%3#0)
        let tmp%5#0: uint64 = (txn ApplicationID)
        let tmp%7#0: bool = (&& tmp%4#0 tmp%5#0)
        (assert tmp%7#0)
        test_cases.gvn.loop_invariant_phi_aliasing.LoopInvariantPhiAliasingContract.run[routing]()
        goto block@4
    block@4: // switch_case_next_L4
        fail
    block@5: // __algopy_default_create_L1
        let tmp%8#0: uint64 = (txn OnCompletion)
        let tmp%9#0: bool = (! tmp%8#0)
        let tmp%10#0: uint64 = (txn ApplicationID)
        let tmp%11#0: bool = (! tmp%10#0)
        let tmp%12#0: bool = (&& tmp%9#0 tmp%11#0)
        (assert tmp%12#0)
        exit 1u

subroutine test_cases.gvn.loop_invariant_phi_aliasing.loop_invariant_phi_aliasing(x: uint64, y: uint64) -> uint64:
    block@0: // L10
        let value_internal%0#0: uint64 = 0u
        goto block@1
    block@1: // for_header_L37
        let value_internal%0#1: uint64 = φ(value_internal%0#0 <- block@0, value_internal%0#2 <- block@2)
        let z#1: uint64 = φ(x#0 <- block@0, z#2 <- block@2)
        let continue_looping%0#0: bool = (< value_internal%0#1 10u)
        goto continue_looping%0#0 ? block@2 : block@4
    block@2: // for_body_L38
        let a#0: uint64 = (+ z#1 y#0)
        let b#0: uint64 = (+ x#0 y#0)
        let z#2: uint64 = (+ a#0 b#0)
        let value_internal%0#2: uint64 = (+ value_internal%0#1 1u)
        goto block@1
    block@4: // after_for_L37
        return z#1

subroutine test_cases.gvn.loop_invariant_phi_aliasing.LoopInvariantPhiAliasingContract.run[routing]() -> void:
    block@0: // L5
        let tmp%0#0: bytes = (txna ApplicationArgs 1)
        let len%0#0: uint64 = (len tmp%0#0)
        let eq%0#0: bool = (== len%0#0 8u)
        (assert eq%0#0) // invalid number of bytes for arc4.uint64
        let x#0: uint64 = decode_bytes<uint64>(tmp%0#0)
        let tmp%2#0: bytes = (txna ApplicationArgs 2)
        let len%1#0: uint64 = (len tmp%2#0)
        let eq%1#0: bool = (== len%1#0 8u)
        (assert eq%1#0) // invalid number of bytes for arc4.uint64
        let y#0: uint64 = decode_bytes<uint64>(tmp%2#0)
        let tmp%0#1: uint64 = test_cases.gvn.loop_invariant_phi_aliasing.loop_invariant_phi_aliasing(x#0, y#0)
        let tmp%5#0: Encoded(uint64) = bytes_encode<uint64>(tmp%0#1)
        let tmp%6#0: bytes = (concat 0x151f7c75 tmp%5#0)
        (log tmp%6#0)
        exit 1u