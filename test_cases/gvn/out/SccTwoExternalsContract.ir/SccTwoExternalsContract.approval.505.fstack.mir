// test_cases.gvn.scc_two_externals.SccTwoExternalsContract.test_alternating[routing]() -> void:
subroutine test_alternating:
    test_alternating_block@0:
        // gvn/scc_two_externals.py:15
        // @public
        txna ApplicationArgs 1                                          tmp%0#0
        l-load-copy tmp%0#0 0                                           tmp%0#0,tmp%0#0 (copy)
        len                                                             tmp%0#0,len%0#0
        int 8                                                           tmp%0#0,len%0#0,8
        ==                                                              tmp%0#0,eq%0#0
        assert // invalid number of bytes for arc4.uint64               tmp%0#0
        l-load tmp%0#0 0                                                tmp%0#0
        btoi                                                            a#0
        txna ApplicationArgs 2                                          a#0,tmp%2#0
        l-load-copy tmp%2#0 0                                           a#0,tmp%2#0,tmp%2#0 (copy)
        len                                                             a#0,tmp%2#0,len%1#0
        int 8                                                           a#0,tmp%2#0,len%1#0,8
        ==                                                              a#0,tmp%2#0,eq%1#0
        assert // invalid number of bytes for arc4.uint64               a#0,tmp%2#0
        l-load tmp%2#0 0                                                a#0,tmp%2#0
        btoi                                                            a#0,b#0
        txna ApplicationArgs 3                                          a#0,b#0,tmp%4#0
        l-load-copy tmp%4#0 0                                           a#0,b#0,tmp%4#0,tmp%4#0 (copy)
        len                                                             a#0,b#0,tmp%4#0,len%2#0
        int 8                                                           a#0,b#0,tmp%4#0,len%2#0,8
        ==                                                              a#0,b#0,tmp%4#0,eq%2#0
        assert // invalid number of bytes for arc4.uint64               a#0,b#0,tmp%4#0
        l-load tmp%4#0 0                                                a#0,b#0,tmp%4#0
        btoi                                                            a#0,b#0,n#0
        // gvn/scc_two_externals.py:17
        // return alternating(a, b, n)
        l-load a#0 2                                                    b#0,n#0,a#0
        l-load b#0 2                                                    n#0,a#0,b#0
        l-load n#0 2                                                    a#0,b#0,n#0
        callsub alternating                                             tmp%0#1
        // gvn/scc_two_externals.py:15
        // @public
        itob                                                            aggregate%val_as_bytes%0#0
        byte 0x151f7c75                                                 aggregate%val_as_bytes%0#0,0x151f7c75
        l-load aggregate%val_as_bytes%0#0 1                             0x151f7c75,aggregate%val_as_bytes%0#0
        concat                                                          tmp%8#0
        log
        int 1                                                           1
        return


