        int 0                                                           (𝕡) a#0,b#0,n#0 | (𝕗) s#0 | value_internal%0#0
        p-load a#0                                                      (𝕡) a#0,b#0,n#0 | (𝕗) s#0 | value_internal%0#0,a#0 (copy)
        f-store x#1                                                     (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1 | value_internal%0#0
        p-load b#0                                                      (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1 | value_internal%0#0,b#0 (copy)
        f-store y#1                                                     (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1,y#1 | value_internal%0#0
        l-load value_internal%0#0 0                                     (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1,y#1 | value_internal%0#0
        f-store i#0                                                     (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1,y#1,i#0 |
        b alternating_for_header@1                                      (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1,y#1,i#0 |

    alternating_for_header@1:                                           (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1,y#1,i#0 |
        // gvn/scc_two_externals.py:25
        // for i in urange(n):
        f-load i#0                                                      (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1,y#1,i#0 | i#0
        p-load n#0                                                      (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1,y#1,i#0 | i#0,n#0 (copy)
        <                                                               (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1,y#1,i#0 | continue_looping%0#0
        bz alternating_after_for@4 ; b alternating_for_body@2           (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1,y#1,i#0 |

    alternating_for_body@2:                                             (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1,y#1,i#0 |
        // gvn/scc_two_externals.py:27
        // s += i
        f-load s#0                                                      (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1,y#1,i#0 | s#0
        f-load i#0                                                      (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1,y#1,i#0 | s#0,i#0
        l-store-copy i#0 1                                              (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1,y#1,i#0 | i#0,s#0,i#0 (copy)
