        f-load x#1                                                      (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1,y#1,i#0 | parcopy%0#0
        f-load y#1                                                      (𝕡) a#0,b#0,n#0 | (𝕗) s#0,x#1,y#1,i#0 | parcopy%0#0,y#1
