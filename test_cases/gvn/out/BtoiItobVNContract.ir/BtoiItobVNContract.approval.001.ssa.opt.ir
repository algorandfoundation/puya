subroutine test_cases.gvn.btoi_itob_vn.test_through_phi(x: uint64) -> void:
    block@0: // L21
        let tmp%0#0: bool = (!= x#0 0u)
        goto x#0 ? block@1 : block@2
    block@1: // if_body_L24
        let b#0: bytes = (itob x#0)
        goto block@3
    block@2: // else_body_L26
        let b#1: bytes = (itob x#0)
        goto block@3
    block@3: // after_if_else_L23
        let b#2: bytes = φ(b#0 <- block@1, b#1 <- block@2)
        let tmp%4#0: bool = 1u
        return 