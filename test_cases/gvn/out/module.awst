contract GVNConstFolding
{
  method_resolution_order: (
    algopy._contract.Contract,
  )
  
  subroutine test_cases.gvn.const_folding.GVNConstFolding.approval_program(): bool
  {
    test_cases.gvn.const_folding.test_setbyte(true)
    test_cases.gvn.const_folding.test_uint64_mod(42u, false)
    test_cases.gvn.const_folding.test_biguint_mod(77259978947021905600184340317603197947481177389714460678206771900175196402510074614992658926100855914496n, true)
    test_cases.gvn.const_folding.test_getbyte_direct()
    test_cases.gvn.const_folding.test_getbyte_through_phi(0u)
    test_cases.gvn.const_folding.test_replace3_large_index()
    test_cases.gvn.const_folding.test_replace3_through_phi(0u)
    test_cases.gvn.const_folding.test_addw()
    test_cases.gvn.const_folding.test_mulw()
    test_cases.gvn.const_folding.test_expw()
    test_cases.gvn.const_folding.test_divw()
    test_cases.gvn.const_folding.test_divmodw()
    test_cases.gvn.const_folding.test_btoi_itob_through_phi(7u)
    test_cases.gvn.const_folding.test_btoi_itob_through_phi(0u)
    return true
  }
  
  subroutine test_cases.gvn.const_folding.GVNConstFolding.clear_state_program(): bool
  {
    return true
  }
  
  subroutine algopy._contract.Contract.__init__(): void
  {
  }
}

subroutine test_setbyte(selector: bool): void
{
  assert(setbyte(hex<"4142">, 0u, 90u) == hex<"5A42">)
  assert(setbyte(hex<"4142">, 1u, 90u) == hex<"415A">)
  if (selector) {
    ab: bytes = bzero(100u) + hex<"4142">
  } else {
    ab: bytes = bzero(100u) + hex<"4142">
  }
  assert(setbyte(ab, 100u, 67u) == bzero(100u) + hex<"4342">)
}

subroutine test_uint64_mod(x: uint64, selector: bool): void
{
  assert(x % 1u == 0u)
  if (selector) {
    one: uint64 = btoi(bzero(65u) + hex<"01">[-7:])
  } else {
    one: uint64 = btoi(bzero(66u) + hex<"01">[-7:])
  }
  assert(x % one == 0u)
}

subroutine test_biguint_mod(x: biguint, selector: bool): void
{
  assert(x b% 1n == 0n)
  if (selector) {
    one: bytes = bzero(65u) + hex<"01">[-10:]
  } else {
    one: bytes = bzero(66u) + hex<"01">[-10:]
  }
  assert(x b% reinterpret_cast<biguint>(one) == 0n)
}

subroutine test_getbyte_direct(): void
{
  assert(getbyte(hex<"68656C6C6F">, 0u) == 104u)
  assert(getbyte(hex<"68656C6C6F">, 4u) == 111u)
}

subroutine test_getbyte_through_phi(selector: uint64): void
{
  if (selector != 0u) {
    b: bytes = hex<"4142">
  } else {
    b: bytes = hex<"4142">
  }
  assert(getbyte(b, 1u) == 66u)
}

subroutine test_replace3_large_index(): void
{
  src: bytes = bzero(300u)
  patched: bytes = replace3(src, 256u, hex<"58595A">)
  assert(getbyte(patched, 256u) == 88u)
}

subroutine test_replace3_through_phi(selector: uint64): void
{
  if (selector != 0u) {
    repl: bytes = hex<"4142">
  } else {
    repl: bytes = hex<"4142">
  }
  out: bytes = replace3(hex<"30303030">, 1u, repl)
  assert(getbyte(out, 1u) == 65u)
}

subroutine test_addw(): void
{
  (carry, lo): tuple<uint64,uint64> = addw(9223372036854775808u, 9223372036854775808u)
  assert(carry == 1u)
  assert(lo == 0u)
}

subroutine test_mulw(): void
{
  (hi, lo): tuple<uint64,uint64> = mulw(4294967296u, 4294967296u)
  assert(hi == 1u)
  assert(lo == 0u)
}

subroutine test_expw(): void
{
  (hi, lo): tuple<uint64,uint64> = expw(2u, 80u)
  assert(hi == 65536u)
  assert(lo == 0u)
}

subroutine test_divw(): void
{
  q: uint64 = divw(1u, 0u, 2u)
  assert(q == 9223372036854775808u)
}

subroutine test_divmodw(): void
{
  (qh, ql, rh, rl): tuple<uint64,uint64,uint64,uint64> = divmodw(1u, 2u, 0u, 3u)
  assert(qh == 0u)
  assert(ql == 6148914691236517206u)
  assert(rh == 0u)
  assert(rl == 0u)
}

subroutine test_btoi_itob_through_phi(x: uint64): void
{
  if (x != 0u) {
    b: bytes = itob(x)
  } else {
    b: bytes = itob(x)
  }
  assert(btoi(b) == x)
}

contract AlgebraicIdentitiesContract
{
  method_resolution_order: (
    algopy._contract.Contract,
  )
  
  subroutine test_cases.gvn.algebraic_identities.AlgebraicIdentitiesContract.approval_program(): bool
  {
    test_cases.gvn.algebraic_identities.test_self_sub(42n, 42u)
    test_cases.gvn.algebraic_identities.test_self_bitwise(42u)
    test_cases.gvn.algebraic_identities.test_one_const(42n, selector=true)
    test_cases.gvn.algebraic_identities.test_one_const(42n, selector=false)
    a: uint64 = txn<NumAppArgs>()
    b: uint64 = a + 1u
    test_cases.gvn.algebraic_identities.test_uint64_swaps(a, b)
    test_cases.gvn.algebraic_identities.test_biguint_swaps(1n, 2n)
    test_cases.gvn.algebraic_identities.test_uint64_negated(a, b)
    test_cases.gvn.algebraic_identities.test_biguint_negated(itob(a), itob(b))
    test_cases.gvn.algebraic_identities.test_uint64_double_negated(a, b)
    test_cases.gvn.algebraic_identities.test_biguint_double_negated(itob(a), itob(b))
    return true
  }
  
  subroutine test_cases.gvn.algebraic_identities.AlgebraicIdentitiesContract.clear_state_program(): bool
  {
    return true
  }
  
  subroutine algopy._contract.Contract.__init__(): void
  {
  }
}

subroutine test_self_sub(x: biguint, y: uint64): void
{
  assert(x b- x == 0n)
  assert(y - y == 0u)
}

subroutine test_self_bitwise(y: uint64): void
{
  assert(y & y == y)
  assert(y | y == y)
}

subroutine test_one_const(x: biguint, selector: bool): void
{
  if (selector) {
    one: biguint = reinterpret_cast<biguint>(bzero(65u) + hex<"01">[-10:])
  } else {
    one: biguint = reinterpret_cast<biguint>(bzero(66u) + hex<"01">[-10:])
  }
  assert(x b* one == x)
  assert(one b* x == x)
}

subroutine test_uint64_swaps(a: uint64, b: uint64): void
{
  assert(a < b)
  assert(b > a)
  assert(a <= b)
  assert(b >= a)
}

subroutine test_biguint_swaps(a: biguint, b: biguint): void
{
  assert(a < b)
  assert(b > a)
  assert(a <= b)
  assert(b >= a)
}

subroutine test_uint64_negated(a: uint64, b: uint64): void
{
  assert(a < b)
  assert(!(a >= b))
  assert(a <= b)
  assert(!(a > b))
  assert(a != b)
  eq_result: bool = a == b
  assert(!(eq_result))
}

subroutine test_biguint_negated(a: biguint, b: biguint): void
{
  assert(a < b)
  assert(!(a >= b))
  assert(a <= b)
  assert(!(a > b))
  assert(a != b)
  eq_result: bool = a == b
  assert(!(eq_result))
}

subroutine test_uint64_double_negated(a: uint64, b: uint64): void
{
  assert(a < b)
  neg: bool = !(a < b)
  assert(!(neg))
}

subroutine test_biguint_double_negated(a: biguint, b: biguint): void
{
  assert(a < b)
  neg: bool = !(a < b)
  assert(!(neg))
}