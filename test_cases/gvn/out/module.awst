subroutine test_large_index(): void
{
  src: bytes = bzero(300u)
  patched: bytes = replace3(src, 256u, hex<"58595A">)
  assert(getbyte(patched, 256u) == 88u)
}

subroutine test_through_phi(selector: uint64): void
{
  if (selector != 0u) {
    repl: bytes = hex<"4142">
  } else {
    repl: bytes = hex<"4142">
  }
  out: bytes = replace3(hex<"30303030">, 1u, repl)
  assert(getbyte(out, 1u) == 65u)
}

