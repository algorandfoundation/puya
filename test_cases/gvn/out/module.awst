subroutine test_direct(): void
{
  assert(getbyte(hex<"68656C6C6F">, 0u) == 104u)
  assert(getbyte(hex<"68656C6C6F">, 4u) == 111u)
}

subroutine test_through_phi(selector: uint64): void
{
  if (selector != 0u) {
    b: bytes = hex<"4142">
  } else {
    b: bytes = hex<"4142">
  }
  assert(getbyte(b, 1u) == 66u)
}

