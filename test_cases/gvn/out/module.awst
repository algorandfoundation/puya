  {
  }
  
  subroutine algopy._contract.Contract.__init__(): void
  {
  }
}

subroutine test_redundant_phi(a: uint64, b: uint64): uint64
{
  val1: uint64 = a | b
  val2: uint64 = b | a
  if (a > b) {
    log(itob(a))
    result: uint64 = val1
  } else {
    log(itob(b))
    result: uint64 = val2
  }
  return result
}

subroutine test_cross_assignment(n: uint64): uint64
{
  x: uint64 = n
  y: uint64 = n
  for _i in range(0u, 10u, 1u) {
    tmp: uint64 = x
    x: uint64 = y
    y: uint64 = tmp
  }
  return x + y
}

subroutine test_triple_cycle(n: uint64): uint64
{
  a: uint64 = n
  b: uint64 = n
  c: uint64 = n
  for _i in range(0u, 5u, 1u) {
    tmp_a: uint64 = a
    tmp_b: uint64 = b
    a: uint64 = c
    b: uint64 = tmp_a
    c: uint64 = tmp_b
  }
  return a + b + c
}

subroutine test_replacement_chain(n: uint64): uint64
{
  a: uint64 = n
  b: uint64 = n
  while (true) {
    if (n == 0u) {
      a: uint64 = n
      b: uint64 = n
    }
    log(itob(a))
    log(itob(b))
    b: uint64 = a
    a: uint64 = b
    if (n % 2u == 0u) {
      break
    }
  }
  return a + b
}

subroutine alternating(a: uint64, b: uint64, n: uint64): uint64
{
  x: uint64 = a
  y: uint64 = b
  s: uint64 = 0u
  for i in range(0u, n, 1u) {
    (x, y): tuple<uint64,uint64> = (y, x)
    s += i
  }
  return x + y + s
}

subroutine alternating_with_commutative_inits(a: uint64, b: uint64, n: uint64): uint64
{
  e1: uint64 = a | b
  e2: uint64 = b | a
  x: uint64 = e1
  y: uint64 = e2
  s: uint64 = 0u
  for i in range(0u, n, 1u) {
    (x, y): tuple<uint64,uint64> = (y, x)
    s += i
  }
  return x + y + s
}

subroutine redundant_phi_moving_vn(n: uint64, y: uint64, cond: bool): uint64
{
  z: uint64 = 0u
  i: uint64 = 0u
  while (i < n) {
    if (cond) {
      w: uint64 = z + y
    } else {
      w: uint64 = z + y
    }
    z: uint64 = w + 1u
    i += 1u
  }
  return z
}

subroutine loop_invariant_phi_aliasing(x: uint64, y: uint64): uint64
{
  z: uint64 = x
  for _i in range(0u, 10u, 1u) {
    a: uint64 = z + y
    b: uint64 = x + y
    z: uint64 = a + b
  }
  return z
}

subroutine deep_nested_accumulator(n: uint64): uint64
{
  x: uint64 = 0u
  for a1 in range(0u, n, 1u) {
    for a2 in range(0u, n, 1u) {
      for a3 in range(0u, n, 1u) {
        for a4 in range(0u, n, 1u) {
          for a5 in range(0u, n, 1u) {
            for a6 in range(0u, n, 1u) {
              for a7 in range(0u, n, 1u) {
                for a8 in range(0u, n, 1u) {
                  for a9 in range(0u, n, 1u) {
                    for a10 in range(0u, n, 1u) {
                      for a11 in range(0u, n, 1u) {
                        for a12 in range(0u, n, 1u) {
                          for a13 in range(0u, n, 1u) {
                            for a14 in range(0u, n, 1u) {
                              x += a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return x
}

subroutine commutative_add_assert(a: uint64, b: uint64, cond: bool): uint64
{
  if (cond) {
    result: uint64 = a + b
    log(concat(concat('cond: ', ''), itob(result)))
  } else {
    result: uint64 = a + b
    log(concat(concat('!cond: ', ''), itob(result)))
  }
  assert(result == b + a)
  return result
}

subroutine nested_scc_collapse(n: uint64, p: uint64, q: uint64): uint64
{
  v: uint64 = n
  i: uint64 = 0u
  while (i < p) {
    j: uint64 = 0u
    while (j < q) {
      v: uint64 = n
      j += 1u
    }
    i += 1u
  }
  return v
}

