  }
  
  abimethod test_cases.gvn.phi_congruence.PhiCongruenceContract.test_moving_vn(n: uint64, y: uint64, cond: bool): uint64
  {
    return test_cases.gvn.phi_congruence.redundant_phi_moving_vn(n, y, cond=cond)
  }
  
