subroutine deep_nested_accumulator(n: uint64): uint64
{
  x: uint64 = 0u
  for a1 in range(0u, n, 1u) {
    for a2 in range(0u, n, 1u) {
      for a3 in range(0u, n, 1u) {
        for a4 in range(0u, n, 1u) {
          for a5 in range(0u, n, 1u) {
            for a6 in range(0u, n, 1u) {
              for a7 in range(0u, n, 1u) {
                for a8 in range(0u, n, 1u) {
                  for a9 in range(0u, n, 1u) {
                    for a10 in range(0u, n, 1u) {
                      for a11 in range(0u, n, 1u) {
                        for a12 in range(0u, n, 1u) {
                          for a13 in range(0u, n, 1u) {
                            for a14 in range(0u, n, 1u) {
                              x += a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return x
}

