        goto block@10
    block@5: // call_test_cross_assignment_route_L20
        test_cases.gvn.phi_congruence.PhiCongruenceContract.call_test_cross_assignment[routing]()
        goto block@10
    block@6: // call_test_triple_cycle_route_L24
        test_cases.gvn.phi_congruence.PhiCongruenceContract.call_test_triple_cycle[routing]()
        goto block@10
    block@7: // call_test_replacement_chain_route_L28
        test_cases.gvn.phi_congruence.PhiCongruenceContract.call_test_replacement_chain[routing]()
        goto block@10
    block@10: // after_if_else_L4
        fail
    block@11: // __algopy_default_create_L1
        let tmp%7#0: uint64 = (txn OnCompletion)
        let tmp%8#0: bool = (! tmp%7#0)
        let tmp%9#0: uint64 = (txn ApplicationID)
        let tmp%10#0: bool = (! tmp%9#0)
        let tmp%11#0: bool = (&& tmp%8#0 tmp%10#0)
        (assert tmp%11#0)
        exit 1u

subroutine test_cases.gvn.phi_congruence.test_redundant_phi(a: uint64, b: uint64) -> uint64:
    block@0: // L33
        let val1#0: uint64 = (| a#0 b#0)
        let tmp%2#0: bool = (> a#0 b#0)
        goto tmp%2#0 ? block@1 : block@2
    block@1: // if_body_L53
        let tmp%3#0: bytes = (itob a#0)
        (log tmp%3#0)
        goto block@3
    block@2: // else_body_L56
        let tmp%4#0: bytes = (itob b#0)
        (log tmp%4#0)
        goto block@3
    block@3: // after_if_else_L52
        return val1#0

subroutine test_cases.gvn.phi_congruence.test_cross_assignment(n: uint64) -> uint64:
    block@0: // L61
        let value_internal%0#0: uint64 = 0u
        goto block@1
    block@1: // for_header_L73
        let _i#0: uint64 = φ(value_internal%0#0 <- block@0, value_internal%0#2 <- block@2)
        let continue_looping%0#0: bool = (< _i#0 10u)
        goto continue_looping%0#0 ? block@2 : block@4
    block@2: // for_body_L74
        let value_internal%0#2: uint64 = (+ _i#0 1u)
        goto block@1
    block@4: // after_for_L73
        let tmp%0#0: uint64 = (+ n#0 n#0)
        return tmp%0#0

subroutine test_cases.gvn.phi_congruence.test_triple_cycle(n: uint64) -> uint64:
    block@0: // L81
