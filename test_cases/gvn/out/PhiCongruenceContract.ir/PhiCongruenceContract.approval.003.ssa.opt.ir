        let value_internal%0#2: uint64 = (+ _i#0 1u)
        goto block@1
    block@4: // after_for_L94
        let tmp%0#0: uint64 = (+ n#0 n#0)
        let tmp%1#0: uint64 = (+ tmp%0#0 n#0)
        return tmp%1#0

subroutine test_cases.gvn.phi_congruence.test_replacement_chain(n: uint64) -> uint64:
    block@1: // while_top_L108
        goto block@4
    block@4: // after_if_else_L109
        let tmp%1#0: bytes = (itob n#0)
        (log tmp%1#0)
        (log tmp%1#0)
        let tmp%3#0: uint64 = (% n#0 2u)
        goto tmp%3#0 ? block@1 : block@5
    block@5: // if_body_L117
        let tmp%5#0: uint64 = (+ n#0 n#0)
