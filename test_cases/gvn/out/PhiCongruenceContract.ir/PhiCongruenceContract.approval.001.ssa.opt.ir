main test_cases.gvn.phi_congruence.PhiCongruenceContract.approval_program:
    block@0: // L12
        let tmp%0#0: uint64 = test_cases.gvn.phi_congruence.test_cross_assignment(42u)
        let tmp%1#0: bool = (== tmp%0#0 84u)
        (assert tmp%1#0)
        let tmp%2#0: uint64 = test_cases.gvn.phi_congruence.test_cross_assignment(0u)
        let tmp%3#0: bool = (! tmp%2#0)
        (assert tmp%3#0)
        let tmp%4#0: uint64 = test_cases.gvn.phi_congruence.test_triple_cycle(10u)
        let tmp%5#0: bool = (== tmp%4#0 30u)
        (assert tmp%5#0)
        let tmp%6#0: uint64 = (txn NumAppArgs)
        let tmp%7#0: uint64 = test_cases.gvn.phi_congruence.test_redundant_phi(tmp%6#0, 5u)
        let tmp%8#0: uint64 = (txn NumAppArgs)
        let tmp%9#0: uint64 = (| tmp%8#0 5u)
        let tmp%10#0: bool = (== tmp%7#0 tmp%9#0)
        (assert tmp%10#0)
        let tmp%11#0: uint64 = test_cases.gvn.phi_congruence.test_replacement_chain(42u)
        let tmp%12#0: bool = (== tmp%11#0 84u)
        (assert tmp%12#0)
        return 1u

subroutine test_cases.gvn.phi_congruence.test_redundant_phi(a: uint64, b: uint64) -> uint64:
    block@0: // L24
        let val1#0: uint64 = (| a#0 b#0)
        let tmp%2#0: bool = (> a#0 b#0)
        goto tmp%2#0 ? block@1 : block@2
    block@1: // if_body_L44
        let tmp%3#0: bytes = (itob a#0)
        (log tmp%3#0)
        goto block@3
    block@2: // else_body_L47
        let tmp%4#0: bytes = (itob b#0)
        (log tmp%4#0)
        goto block@3
    block@3: // after_if_else_L43
        return val1#0

subroutine test_cases.gvn.phi_congruence.test_cross_assignment(n: uint64) -> uint64:
    block@0: // L52
        let value_internal%0#0: uint64 = 0u
        goto block@1
    block@1: // for_header_L64
        let _i#0: uint64 = φ(value_internal%0#0 <- block@0, value_internal%0#2 <- block@2)
        let continue_looping%0#0: bool = (< _i#0 10u)
        goto continue_looping%0#0 ? block@2 : block@4
    block@2: // for_body_L65
        let value_internal%0#2: uint64 = (+ _i#0 1u)
        goto block@1
    block@4: // after_for_L64
        let tmp%0#0: uint64 = (+ n#0 n#0)
        return tmp%0#0

subroutine test_cases.gvn.phi_congruence.test_triple_cycle(n: uint64) -> uint64:
    block@0: // L72
        let value_internal%0#0: uint64 = 0u
        goto block@1
    block@1: // for_header_L85
        let _i#0: uint64 = φ(value_internal%0#0 <- block@0, value_internal%0#2 <- block@2)
        let continue_looping%0#0: bool = (< _i#0 5u)
        goto continue_looping%0#0 ? block@2 : block@4
    block@2: // for_body_L86
        let value_internal%0#2: uint64 = (+ _i#0 1u)
        goto block@1
    block@4: // after_for_L85
        let tmp%0#0: uint64 = (+ n#0 n#0)
        let tmp%1#0: uint64 = (+ tmp%0#0 n#0)
        return tmp%1#0

subroutine test_cases.gvn.phi_congruence.test_replacement_chain(n: uint64) -> uint64:
    block@0: // L95
        goto block@1
    block@1: // while_top_L99
        let a#3: uint64 = φ(n#0 <- block@0, a#2 <- block@6)
        let tmp%0#0: bool = (! n#0)
        goto n#0 ? block@4 : block@3
    block@3: // if_body_L101
        goto block@4
    block@4: // after_if_else_L100
        let a#2: uint64 = φ(a#3 <- block@1, n#0 <- block@3)
        let tmp%1#0: bytes = (itob a#2)
        (log tmp%1#0)
        (log tmp%1#0)
        goto n#0 ? block@6 : block@5
    block@5: // if_body_L108
        let (a#5: uint64, b#5: uint64) = (a#2, a#2)
        let tmp%4#0: uint64 = (+ a#5 b#5)
        return tmp%4#0
    block@6: // after_if_else_L107
        goto block@1