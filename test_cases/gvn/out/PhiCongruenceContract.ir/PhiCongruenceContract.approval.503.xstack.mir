        b alternating_with_commutative_inits_for_header@1                                        (𝕡) a#0,b#0,n#0 |

    alternating_with_commutative_inits_after_for@4:                                              (𝕡) a#0,b#0,n#0 |
        // gvn/phi_congruence.py:133
        // return x + y + s
        v-load e1#0                                                                              (𝕡) a#0,b#0,n#0 | e1#0
        l-store-copy e1#0 0                                                                      (𝕡) a#0,b#0,n#0 | e1#0,e1#0 (copy)
        l-load e1#0 1                                                                            (𝕡) a#0,b#0,n#0 | e1#0 (copy),e1#0
        +                                                                                        (𝕡) a#0,b#0,n#0 | tmp%3#0
        v-load s#0                                                                               (𝕡) a#0,b#0,n#0 | tmp%3#0,s#0
        +                                                                                        (𝕡) a#0,b#0,n#0 | tmp%4#0
        retsub                                                                                   tmp%4#0


// test_cases.gvn.phi_congruence.redundant_phi_moving_vn(n: uint64, y: uint64, cond: uint64) -> uint64:
subroutine redundant_phi_moving_vn:
    redundant_phi_moving_vn_block@0:                                                             (𝕡) n#0,y#0,cond#0 |
        // gvn/phi_congruence.py:138
        // z = UInt64(0)
        int 0                                                                                    (𝕡) n#0,y#0,cond#0 | 0
        v-store z#0                                                                              (𝕡) n#0,y#0,cond#0 |
        // gvn/phi_congruence.py:139
        // i = UInt64(0)
        int 0                                                                                    (𝕡) n#0,y#0,cond#0 | 0
        v-store i#0                                                                              (𝕡) n#0,y#0,cond#0 |
        b redundant_phi_moving_vn_while_top@1                                                    (𝕡) n#0,y#0,cond#0 |

    redundant_phi_moving_vn_while_top@1:                                                         (𝕡) n#0,y#0,cond#0 |
        // gvn/phi_congruence.py:140
        // while i < n:
        v-load i#0                                                                               (𝕡) n#0,y#0,cond#0 | i#0
        p-load n#0                                                                               (𝕡) n#0,y#0,cond#0 | i#0,n#0 (copy)
        <                                                                                        (𝕡) n#0,y#0,cond#0 | tmp%0#0
        bz redundant_phi_moving_vn_after_while@6 ; b redundant_phi_moving_vn_while_body@2 (𝕡) n#0,y#0,cond#0 | 

    redundant_phi_moving_vn_while_body@2:                                                        (𝕡) n#0,y#0,cond#0 |
        // gvn/phi_congruence.py:141
        // if cond:
        p-load cond#0                                                                            (𝕡) n#0,y#0,cond#0 | cond#0 (copy)
        bz redundant_phi_moving_vn_else_body@4 ; b redundant_phi_moving_vn_if_body@3             (𝕡) n#0,y#0,cond#0 |

    redundant_phi_moving_vn_if_body@3:                                                           (𝕡) n#0,y#0,cond#0 |
        // gvn/phi_congruence.py:142
        // w = z + y
        v-load z#0                                                                               (𝕡) n#0,y#0,cond#0 | z#0
        p-load y#0                                                                               (𝕡) n#0,y#0,cond#0 | z#0,y#0 (copy)
        +                                                                                        (𝕡) n#0,y#0,cond#0 | w#0
        x-store w#0                                                                              (𝕡) n#0,y#0,cond#0 | (𝕏) w#0 |
        b redundant_phi_moving_vn_after_if_else@5                                                (𝕡) n#0,y#0,cond#0 | (𝕏) w#0 |

    redundant_phi_moving_vn_else_body@4:                                                         (𝕡) n#0,y#0,cond#0 |
        // gvn/phi_congruence.py:144
        // w = z + y
        v-load z#0                                                                               (𝕡) n#0,y#0,cond#0 | z#0
        p-load y#0                                                                               (𝕡) n#0,y#0,cond#0 | z#0,y#0 (copy)
        +                                                                                        (𝕡) n#0,y#0,cond#0 | w#0
        x-store w#0                                                                              (𝕡) n#0,y#0,cond#0 | (𝕏) w#0 |
        b redundant_phi_moving_vn_after_if_else@5                                                (𝕡) n#0,y#0,cond#0 | (𝕏) w#0 |

    redundant_phi_moving_vn_after_if_else@5:                                                     (𝕡) n#0,y#0,cond#0 | (𝕏) w#0 |
        // gvn/phi_congruence.py:145
        // z = w + UInt64(1)
        x-load w#0                                                                               (𝕡) n#0,y#0,cond#0 | w#0
        int 1                                                                                    (𝕡) n#0,y#0,cond#0 | w#0,1
        +                                                                                        (𝕡) n#0,y#0,cond#0 | z#0
        v-store z#0                                                                              (𝕡) n#0,y#0,cond#0 |
        // gvn/phi_congruence.py:146
        // i += UInt64(1)
        v-load i#0                                                                               (𝕡) n#0,y#0,cond#0 | i#0
        int 1                                                                                    (𝕡) n#0,y#0,cond#0 | i#0,1
        +                                                                                        (𝕡) n#0,y#0,cond#0 | i#0
        v-store i#0                                                                              (𝕡) n#0,y#0,cond#0 |
        b redundant_phi_moving_vn_while_top@1                                                    (𝕡) n#0,y#0,cond#0 |

    redundant_phi_moving_vn_after_while@6:                                                       (𝕡) n#0,y#0,cond#0 |
        // gvn/phi_congruence.py:147
        // return z
        v-load z#0                                                                               (𝕡) n#0,y#0,cond#0 | z#0
        retsub                                                                                   z#0


// test_cases.gvn.phi_congruence.loop_invariant_phi_aliasing(x: uint64, y: uint64) -> uint64:
subroutine loop_invariant_phi_aliasing:
    loop_invariant_phi_aliasing_block@0:                                                         (𝕡) x#0,y#0 |
        // gvn/phi_congruence.py:153
        // for _i in urange(10):
        int 0                                                                                    (𝕡) x#0,y#0 | 0
        v-store value_internal%0#0                                                               (𝕡) x#0,y#0 |
        p-load x#0                                                                               (𝕡) x#0,y#0 | x#0 (copy)
        v-store z#1                                                                              (𝕡) x#0,y#0 |
        b loop_invariant_phi_aliasing_for_header@1                                               (𝕡) x#0,y#0 |

    loop_invariant_phi_aliasing_for_header@1:                                                    (𝕡) x#0,y#0 |
        // gvn/phi_congruence.py:153
        // for _i in urange(10):
        v-load value_internal%0#0                                                                (𝕡) x#0,y#0 | value_internal%0#0
        int 10                                                                                   (𝕡) x#0,y#0 | value_internal%0#0,10
        <                                                                                        (𝕡) x#0,y#0 | continue_looping%0#0
        bz loop_invariant_phi_aliasing_after_for@4 ; b loop_invariant_phi_aliasing_for_body@2 (𝕡) x#0,y#0 | 

    loop_invariant_phi_aliasing_for_body@2:                                                      (𝕡) x#0,y#0 |
        // gvn/phi_congruence.py:154
        // a = z + y
        v-load z#1                                                                               (𝕡) x#0,y#0 | z#1
        p-load y#0                                                                               (𝕡) x#0,y#0 | z#1,y#0 (copy)
        +                                                                                        (𝕡) x#0,y#0 | a#0
        // gvn/phi_congruence.py:155
        // b = x + y
        p-load x#0                                                                               (𝕡) x#0,y#0 | a#0,x#0 (copy)
        p-load y#0                                                                               (𝕡) x#0,y#0 | a#0,x#0 (copy),y#0 (copy)
        +                                                                                        (𝕡) x#0,y#0 | a#0,b#0
        // gvn/phi_congruence.py:156
        // z = a + b
        l-load a#0 1                                                                             (𝕡) x#0,y#0 | b#0,a#0
        l-load b#0 1                                                                             (𝕡) x#0,y#0 | a#0,b#0
        +                                                                                        (𝕡) x#0,y#0 | z#1
        v-store z#1                                                                              (𝕡) x#0,y#0 |
        // gvn/phi_congruence.py:153
        // for _i in urange(10):
        v-load value_internal%0#0                                                                (𝕡) x#0,y#0 | value_internal%0#0
        int 1                                                                                    (𝕡) x#0,y#0 | value_internal%0#0,1
        +                                                                                        (𝕡) x#0,y#0 | value_internal%0#0
        v-store value_internal%0#0                                                               (𝕡) x#0,y#0 |
        b loop_invariant_phi_aliasing_for_header@1                                               (𝕡) x#0,y#0 |

    loop_invariant_phi_aliasing_after_for@4:                                                     (𝕡) x#0,y#0 |
        // gvn/phi_congruence.py:157
        // return z
        v-load z#1                                                                               (𝕡) x#0,y#0 | z#1
        retsub                                                                                   z#1


