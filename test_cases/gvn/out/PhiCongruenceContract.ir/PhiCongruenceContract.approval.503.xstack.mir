        v-load x#1                                                                               (𝕡) a#0,b#0,n#0 | parcopy%0#0
        v-load y#1                                                                               (𝕡) a#0,b#0,n#0 | parcopy%0#0,y#1
        v-store x#1                                                                              (𝕡) a#0,b#0,n#0 | parcopy%0#0
        l-load parcopy%0#0 0                                                                     (𝕡) a#0,b#0,n#0 | parcopy%0#0
        v-store y#1                                                                              (𝕡) a#0,b#0,n#0 |
        b alternating_for_header@1                                                               (𝕡) a#0,b#0,n#0 |

    alternating_after_for@4:                                                                     (𝕡) a#0,b#0,n#0 |
        // gvn/phi_congruence.py:120
        // return x + y + s
        v-load x#1                                                                               (𝕡) a#0,b#0,n#0 | x#1
        v-load y#1                                                                               (𝕡) a#0,b#0,n#0 | x#1,y#1
