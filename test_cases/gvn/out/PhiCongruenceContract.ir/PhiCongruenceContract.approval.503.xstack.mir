        // gvn/phi_congruence.py:117
        // for i in urange(n):
        int 0                                                                                    (𝕡) a#0,b#0,n#0 | value_internal%0#0
        p-load a#0                                                                               (𝕡) a#0,b#0,n#0 | value_internal%0#0,a#0 (copy)
        v-store x#1                                                                              (𝕡) a#0,b#0,n#0 | value_internal%0#0
        p-load b#0                                                                               (𝕡) a#0,b#0,n#0 | value_internal%0#0,b#0 (copy)
        v-store y#1                                                                              (𝕡) a#0,b#0,n#0 | value_internal%0#0
        l-load value_internal%0#0 0                                                              (𝕡) a#0,b#0,n#0 | value_internal%0#0
        v-store i#0                                                                              (𝕡) a#0,b#0,n#0 |
        b alternating_for_header@1                                                               (𝕡) a#0,b#0,n#0 |

    alternating_for_header@1:                                                                    (𝕡) a#0,b#0,n#0 |
        // gvn/phi_congruence.py:117
        // for i in urange(n):
        v-load i#0                                                                               (𝕡) a#0,b#0,n#0 | i#0
        p-load n#0                                                                               (𝕡) a#0,b#0,n#0 | i#0,n#0 (copy)
        <                                                                                        (𝕡) a#0,b#0,n#0 | continue_looping%0#0
        bz alternating_after_for@4 ; b alternating_for_body@2                                    (𝕡) a#0,b#0,n#0 |

    alternating_for_body@2:                                                                      (𝕡) a#0,b#0,n#0 |
        // gvn/phi_congruence.py:119
