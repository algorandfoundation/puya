// test_cases.gvn.phi_congruence.commutative_add_assert(a: uint64, b: uint64, cond: uint64) -> uint64:
subroutine commutative_add_assert:
    commutative_add_assert_block@0:                                                              (𝕡) a#0,b#0,cond#0 |
        // gvn/phi_congruence.py:202
        // if cond:
        p-load cond#0                                                                            (𝕡) a#0,b#0,cond#0 | cond#0 (copy)
        bz commutative_add_assert_else_body@2 ; b commutative_add_assert_if_body@1               (𝕡) a#0,b#0,cond#0 |

    commutative_add_assert_if_body@1:                                                            (𝕡) a#0,b#0,cond#0 |
        // gvn/phi_congruence.py:203
        // result = a + b
        p-load a#0                                                                               (𝕡) a#0,b#0,cond#0 | a#0 (copy)
        p-load b#0                                                                               (𝕡) a#0,b#0,cond#0 | a#0 (copy),b#0 (copy)
        +                                                                                        (𝕡) a#0,b#0,cond#0 | result#0
