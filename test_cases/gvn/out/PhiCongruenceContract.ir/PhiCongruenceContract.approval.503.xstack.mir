    nested_scc_collapse_while_top@3:                                                             (𝕡) n#0,p#0,q#0 |
        // gvn/phi_congruence.py:221
        // while j < q:
        v-load j#0                                                                               (𝕡) n#0,p#0,q#0 | j#0
        p-load q#0                                                                               (𝕡) n#0,p#0,q#0 | j#0,q#0 (copy)
        <                                                                                        (𝕡) n#0,p#0,q#0 | tmp%1#0
        bz nested_scc_collapse_after_while@5 ; b nested_scc_collapse_while_body@4                (𝕡) n#0,p#0,q#0 |

    nested_scc_collapse_while_body@4:                                                            (𝕡) n#0,p#0,q#0 |
        // gvn/phi_congruence.py:223
