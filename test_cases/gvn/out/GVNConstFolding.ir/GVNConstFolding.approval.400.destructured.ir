subroutine test_cases.gvn.const_folding.test_uint64_mod(x: uint64, selector: bool) -> void:
    block@0: // L27
        let tmp%0#0: uint64 = (% x#0 1u)
        let tmp%1#0: bool = (! tmp%0#0)
        (assert tmp%1#0)
        goto selector#0 ? block@1 : block@2
    block@1: // if_body_L35
        let tmp%2#0: bytes = (bzero 65u)
        let tmp%3#0: bytes = (concat tmp%2#0 0x01)
        let tmp%4#0: bytes = ((substring 56 66) tmp%3#0)
        let one#0: uint64 = (btoi tmp%4#0)
