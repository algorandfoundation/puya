        substring 56 66                                                (𝕡) x#0,selector#0 | one#0
        v-store one#0                                                  (𝕡) x#0,selector#0 |
        b test_biguint_mod_after_if_else@3                             (𝕡) x#0,selector#0 |

    test_biguint_mod_else_body@2:                                      (𝕡) x#0,selector#0 |
        // gvn/const_folding.py:51
        // one = (op.bzero(66) + b"\x01")[-10:]
        int 66                                                         (𝕡) x#0,selector#0 | 66
        bzero                                                          (𝕡) x#0,selector#0 | tmp%5#0
