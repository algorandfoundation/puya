// test_cases.gvn.const_folding.GVNConstFolding.entry[routing]() -> void:
subroutine entry:
    entry_block@0:
        // gvn/const_folding.py:7
        // test_setbyte(True)
        int 1                                                          1
        callsub test_setbyte
        // gvn/const_folding.py:8
        // test_uint64_mod(UInt64(42), False)
        int 42                                                         42
        int 0                                                          42,0
        callsub test_uint64_mod
        // gvn/const_folding.py:9
        // test_biguint_mod(BigUInt(42**64), True)
        byte 0x0227eb7da8f7a843ac592cb594e3b9ef0876d3dee6e243fe9763733a81bb74a9b45833010000000000000000 0x0227eb7da8f7a843ac592cb594e3b9ef0876d3dee6e243fe9763733a81bb74a9b45833010000000000000000
        int 1                                                          0x0227eb7da8f7a843ac592cb594e3b9ef0876d3dee6e243fe9763733a81bb74a9b45833010000000000000000,1
        callsub test_biguint_mod
        // gvn/const_folding.py:5
        // @public
        int 1                                                          1
        return


