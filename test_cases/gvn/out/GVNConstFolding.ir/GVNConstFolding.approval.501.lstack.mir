// test_cases.gvn.const_folding.test_uint64_mod(x: uint64, selector: uint64) -> void:
subroutine test_uint64_mod:
    test_uint64_mod_block@0:                                           (𝕡) x#0,selector#0 |
        // gvn/const_folding.py:30
        // assert x % 1 == 0
        p-load x#0                                                     (𝕡) x#0,selector#0 | x#0 (copy)
        int 1                                                          (𝕡) x#0,selector#0 | x#0 (copy),1
        %                                                              (𝕡) x#0,selector#0 | tmp%0#0
        l-load tmp%0#0 0                                               (𝕡) x#0,selector#0 | tmp%0#0
        !                                                              (𝕡) x#0,selector#0 | tmp%1#0
        l-load tmp%1#0 0                                               (𝕡) x#0,selector#0 | tmp%1#0
        assert                                                         (𝕡) x#0,selector#0 |
        // gvn/const_folding.py:34
        // if selector:
        p-load selector#0                                              (𝕡) x#0,selector#0 | selector#0 (copy)
        bz test_uint64_mod_else_body@2 ; b test_uint64_mod_if_body@1   (𝕡) x#0,selector#0 |

    test_uint64_mod_if_body@1:                                         (𝕡) x#0,selector#0 |
        // gvn/const_folding.py:35
        // one = op.btoi((op.bzero(65) + b"\x01")[-10:])
        int 65                                                         (𝕡) x#0,selector#0 | 65
        bzero                                                          (𝕡) x#0,selector#0 | tmp%2#0
        l-load tmp%2#0 0                                               (𝕡) x#0,selector#0 | tmp%2#0
        byte 0x01                                                      (𝕡) x#0,selector#0 | tmp%2#0,0x01
        concat                                                         (𝕡) x#0,selector#0 | tmp%3#0
        l-load tmp%3#0 0                                               (𝕡) x#0,selector#0 | tmp%3#0
        substring 56 66                                                (𝕡) x#0,selector#0 | tmp%4#0
        l-load tmp%4#0 0                                               (𝕡) x#0,selector#0 | tmp%4#0
        btoi                                                           (𝕡) x#0,selector#0 | one#0
        v-store one#0                                                  (𝕡) x#0,selector#0 |
        b test_uint64_mod_after_if_else@3                              (𝕡) x#0,selector#0 |

    test_uint64_mod_else_body@2:                                       (𝕡) x#0,selector#0 |
        // gvn/const_folding.py:37
        // one = op.btoi((op.bzero(66) + b"\x01")[-10:])
        int 66                                                         (𝕡) x#0,selector#0 | 66
        bzero                                                          (𝕡) x#0,selector#0 | tmp%6#0
        l-load tmp%6#0 0                                               (𝕡) x#0,selector#0 | tmp%6#0
        byte 0x01                                                      (𝕡) x#0,selector#0 | tmp%6#0,0x01
        concat                                                         (𝕡) x#0,selector#0 | tmp%7#0
        l-load tmp%7#0 0                                               (𝕡) x#0,selector#0 | tmp%7#0
        substring 57 67                                                (𝕡) x#0,selector#0 | tmp%8#0
        l-load tmp%8#0 0                                               (𝕡) x#0,selector#0 | tmp%8#0
        btoi                                                           (𝕡) x#0,selector#0 | one#0
        v-store one#0                                                  (𝕡) x#0,selector#0 |
        b test_uint64_mod_after_if_else@3                              (𝕡) x#0,selector#0 |

    test_uint64_mod_after_if_else@3:                                   (𝕡) x#0,selector#0 |
        // gvn/const_folding.py:38
        // assert x % one == 0
        p-load x#0                                                     (𝕡) x#0,selector#0 | x#0 (copy)
        v-load one#0                                                   (𝕡) x#0,selector#0 | x#0 (copy),one#0
        %                                                              (𝕡) x#0,selector#0 | tmp%10#0
        l-load tmp%10#0 0                                              (𝕡) x#0,selector#0 | tmp%10#0
        !                                                              (𝕡) x#0,selector#0 | tmp%11#0
        l-load tmp%11#0 0                                              (𝕡) x#0,selector#0 | tmp%11#0
        assert                                                         (𝕡) x#0,selector#0 |
        retsub


