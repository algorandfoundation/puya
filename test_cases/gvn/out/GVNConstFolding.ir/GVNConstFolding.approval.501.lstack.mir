// test_cases.gvn.const_folding.test_divmodw() -> void:
subroutine test_divmodw:
    test_divmodw_block@0:
        // gvn/const_folding.py:125
        // qh, ql, rh, rl = op.divmodw(1, 2, 0, 3)
        int 1                                                          1
        int 2                                                          1,2
        int 0                                                          1,2,0
        int 3                                                          1,2,0,3
        divmodw                                                        qh#0,ql#0,rh#0,rl#0
        // gvn/const_folding.py:126
        // assert qh == 0
        l-load qh#0 3                                                  ql#0,rh#0,rl#0,qh#0
        !                                                              ql#0,rh#0,rl#0,tmp%4#0
        l-load tmp%4#0 0                                               ql#0,rh#0,rl#0,tmp%4#0
        assert                                                         ql#0,rh#0,rl#0
        // gvn/const_folding.py:127
        // assert ql == ((1 << 64) + 2) // 3
        l-load ql#0 2                                                  rh#0,rl#0,ql#0
        int 6148914691236517206                                        rh#0,rl#0,ql#0,6148914691236517206
        ==                                                             rh#0,rl#0,tmp%5#0
        l-load tmp%5#0 0                                               rh#0,rl#0,tmp%5#0
        assert                                                         rh#0,rl#0
        // gvn/const_folding.py:128
        // assert rh == 0
        l-load rh#0 1                                                  rl#0,rh#0
        !                                                              rl#0,tmp%6#0
        l-load tmp%6#0 0                                               rl#0,tmp%6#0
        assert                                                         rl#0
        // gvn/const_folding.py:129
        // assert rl == ((1 << 64) + 2) % 3
        l-load rl#0 0                                                  rl#0
        !                                                              tmp%7#0
        l-load tmp%7#0 0                                               tmp%7#0
        assert
        retsub


// test_cases.gvn.const_folding.test_btoi_itob_through_phi(x: uint64) -> void:
subroutine test_btoi_itob_through_phi:
    test_btoi_itob_through_phi_block@0:                                (𝕡) x#0 |
        // gvn/const_folding.py:134
        // if x:
        p-load x#0                                                     (𝕡) x#0 | x#0 (copy)
        bz test_btoi_itob_through_phi_else_body@2 ; b test_btoi_itob_through_phi_if_body@1 (𝕡) x#0 | 

    test_btoi_itob_through_phi_if_body@1:                              (𝕡) x#0 |
        // gvn/const_folding.py:135
        // b = op.itob(x)
        p-load x#0                                                     (𝕡) x#0 | x#0 (copy)
        itob                                                           (𝕡) x#0 | b#0
        v-store b#0                                                    (𝕡) x#0 |
        b test_btoi_itob_through_phi_after_if_else@3                   (𝕡) x#0 |

    test_btoi_itob_through_phi_else_body@2:                            (𝕡) x#0 |
        // gvn/const_folding.py:137
        // b = op.itob(x)
        p-load x#0                                                     (𝕡) x#0 | x#0 (copy)
        itob                                                           (𝕡) x#0 | b#0
        v-store b#0                                                    (𝕡) x#0 |
        b test_btoi_itob_through_phi_after_if_else@3                   (𝕡) x#0 |

    test_btoi_itob_through_phi_after_if_else@3:                        (𝕡) x#0 |
        // gvn/const_folding.py:138
        // assert op.btoi(b) == x
        v-load b#0                                                     (𝕡) x#0 | b#0
        btoi                                                           (𝕡) x#0 | tmp%3#0
        l-load tmp%3#0 0                                               (𝕡) x#0 | tmp%3#0
        p-load x#0                                                     (𝕡) x#0 | tmp%3#0,x#0 (copy)
        ==                                                             (𝕡) x#0 | tmp%4#0
        l-load tmp%4#0 0                                               (𝕡) x#0 | tmp%4#0
        assert                                                         (𝕡) x#0 |
        retsub


