subroutine test_cases.gvn.const_folding.test_setbyte(selector: bool) -> void:
    block@0: // L10
        let tmp%0#0: bytes = 0x5a42
        let tmp%1#0: bool = 1u
        let tmp%2#0: bytes = 0x415a
