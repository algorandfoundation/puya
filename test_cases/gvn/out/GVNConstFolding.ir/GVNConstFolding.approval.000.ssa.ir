subroutine test_cases.gvn.const_folding.test_setbyte(selector: bool) -> void:
    block@0: // L32
        let tmp%0#0: bytes = (setbyte 0x4142 0u 90u)
        let tmp%1#0: bool = (== tmp%0#0 0x5a42)
        (assert tmp%1#0)
        let tmp%2#0: bytes = (setbyte 0x4142 1u 90u)
        let tmp%3#0: bool = (== tmp%2#0 0x415a)
        (assert tmp%3#0)
        goto selector#0 ? block@1 : block@2
    block@1: // if_body_L37
        let tmp%4#0: bytes = (bzero 100u)
        let tmp%5#0: bytes = (concat tmp%4#0 0x4142)
        let ab#0: bytes = tmp%5#0
        goto block@3
    block@2: // else_body_L39
        let tmp%6#0: bytes = (bzero 100u)
        let tmp%7#0: bytes = (concat tmp%6#0 0x4142)
        let ab#1: bytes = tmp%7#0
        goto block@3
    block@3: // after_if_else_L36
        let ab#2: bytes = φ(ab#0 <- block@1, ab#1 <- block@2)
        let tmp%8#0: bytes = (setbyte ab#2 100u 67u)
        let tmp%9#0: bytes = (bzero 100u)
        let tmp%10#0: bytes = (concat tmp%9#0 0x4342)
        let tmp%11#0: bool = (== tmp%8#0 tmp%10#0)
        (assert tmp%11#0)
        return 

