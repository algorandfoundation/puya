        let bounded_index%1#0: uint64 = (- length%1#0 bounded_offset%1#0)
        let tmp%8#0: bytes = (substring3 tmp%7#0 bounded_index%1#0 length%1#0)
        let tmp%9#0: uint64 = (btoi tmp%8#0)
        let one#1: uint64 = tmp%9#0
        goto block@3
    block@3: // after_if_else_L46
        let one#2: uint64 = φ(one#0 <- block@1, one#1 <- block@2)
