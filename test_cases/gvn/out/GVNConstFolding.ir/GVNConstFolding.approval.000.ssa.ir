        let bounded_index%0#0: uint64 = (- length%0#0 bounded_offset%0#0)
        let tmp%4#0: bytes = (substring3 tmp%3#0 bounded_index%0#0 length%0#0)
        let tmp%5#0: uint64 = (btoi tmp%4#0)
        let one#0: uint64 = tmp%5#0
        goto block@3
    block@2: // else_body_L49
        let tmp%6#0: bytes = (bzero 66u)
        let tmp%7#0: bytes = (concat tmp%6#0 0x01)
        let length%1#0: uint64 = (len tmp%7#0)
        let is_out_of_bounds%1#0: bool = (>= 7u length%1#0)
