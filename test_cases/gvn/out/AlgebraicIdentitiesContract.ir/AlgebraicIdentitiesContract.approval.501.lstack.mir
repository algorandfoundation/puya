// test_cases.gvn.algebraic_identities.test_uint64_swaps(a: uint64, b: uint64) -> void:
subroutine test_uint64_swaps:
    test_uint64_swaps_block@0:                                 (𝕡) a#0,b#0 |
        // gvn/algebraic_identities.py:55
        // assert a < b
        p-load a#0                                             (𝕡) a#0,b#0 | a#0 (copy)
        p-load b#0                                             (𝕡) a#0,b#0 | a#0 (copy),b#0 (copy)
        <                                                      (𝕡) a#0,b#0 | tmp%0#0
        l-load tmp%0#0 0                                       (𝕡) a#0,b#0 | tmp%0#0
        assert                                                 (𝕡) a#0,b#0 |
        // gvn/algebraic_identities.py:57
        // assert a <= b
        p-load a#0                                             (𝕡) a#0,b#0 | a#0 (copy)
        p-load b#0                                             (𝕡) a#0,b#0 | a#0 (copy),b#0 (copy)
        <=                                                     (𝕡) a#0,b#0 | tmp%2#0
        l-load tmp%2#0 0                                       (𝕡) a#0,b#0 | tmp%2#0
        assert                                                 (𝕡) a#0,b#0 |
        retsub


