// test_cases.gvn.scc_vn_merged_externals.alternating_with_commutative_inits(a: uint64, b: uint64, n: uint64) -> uint64:
subroutine alternating_with_commutative_inits:
    alternating_with_commutative_inits_block@0:                                   (𝕡) a#0,b#0,n#0 |
        // gvn/scc_vn_merged_externals.py:24
        // e1 = a | b
        p-load a#0                                                                (𝕡) a#0,b#0,n#0 | a#0 (copy)
        p-load b#0                                                                (𝕡) a#0,b#0,n#0 | a#0 (copy),b#0 (copy)
        |                                                                         (𝕡) a#0,b#0,n#0 | e1#0
        v-store e1#0                                                              (𝕡) a#0,b#0,n#0 |
        // gvn/scc_vn_merged_externals.py:28
        // s = UInt64(0)
        int 0                                                                     (𝕡) a#0,b#0,n#0 | 0
        v-store s#0                                                               (𝕡) a#0,b#0,n#0 |
        // gvn/scc_vn_merged_externals.py:29
        // for i in urange(n):
        int 0                                                                     (𝕡) a#0,b#0,n#0 | 0
        l-store value_internal%0#0 0                                              (𝕡) a#0,b#0,n#0 | value_internal%0#0
        l-load value_internal%0#0 0                                               (𝕡) a#0,b#0,n#0 | value_internal%0#0
        v-store i#0                                                               (𝕡) a#0,b#0,n#0 |
        b alternating_with_commutative_inits_for_header@1                         (𝕡) a#0,b#0,n#0 |

    alternating_with_commutative_inits_for_header@1:                              (𝕡) a#0,b#0,n#0 |
        // gvn/scc_vn_merged_externals.py:29
        // for i in urange(n):
        v-load i#0                                                                (𝕡) a#0,b#0,n#0 | i#0
        p-load n#0                                                                (𝕡) a#0,b#0,n#0 | i#0,n#0 (copy)
        <                                                                         (𝕡) a#0,b#0,n#0 | continue_looping%0#0
        l-load continue_looping%0#0 0                                             (𝕡) a#0,b#0,n#0 | continue_looping%0#0
        bz alternating_with_commutative_inits_after_for@4 ; b alternating_with_commutative_inits_for_body@2 (𝕡) a#0,b#0,n#0 | 

    alternating_with_commutative_inits_for_body@2:                                (𝕡) a#0,b#0,n#0 |
        // gvn/scc_vn_merged_externals.py:31
        // s += i
        v-load s#0                                                                (𝕡) a#0,b#0,n#0 | s#0
        v-load i#0                                                                (𝕡) a#0,b#0,n#0 | s#0,i#0
        l-store-copy i#0 1                                                        (𝕡) a#0,b#0,n#0 | i#0,s#0,i#0 (copy)
        +                                                                         (𝕡) a#0,b#0,n#0 | i#0,s#0
        v-store s#0                                                               (𝕡) a#0,b#0,n#0 | i#0
        // gvn/scc_vn_merged_externals.py:29
        // for i in urange(n):
        l-load i#0 0                                                              (𝕡) a#0,b#0,n#0 | i#0
        int 1                                                                     (𝕡) a#0,b#0,n#0 | i#0,1
        +                                                                         (𝕡) a#0,b#0,n#0 | value_internal%0#0
        l-load value_internal%0#0 0                                               (𝕡) a#0,b#0,n#0 | value_internal%0#0
        v-store i#0                                                               (𝕡) a#0,b#0,n#0 |
        b alternating_with_commutative_inits_for_header@1                         (𝕡) a#0,b#0,n#0 |

    alternating_with_commutative_inits_after_for@4:                               (𝕡) a#0,b#0,n#0 |
        // gvn/scc_vn_merged_externals.py:32
        // return x + y + s
        v-load e1#0                                                               (𝕡) a#0,b#0,n#0 | e1#0
        l-store-copy e1#0 0                                                       (𝕡) a#0,b#0,n#0 | e1#0,e1#0 (copy)
        l-load e1#0 1                                                             (𝕡) a#0,b#0,n#0 | e1#0 (copy),e1#0
        +                                                                         (𝕡) a#0,b#0,n#0 | tmp%3#0
        l-load tmp%3#0 0                                                          (𝕡) a#0,b#0,n#0 | tmp%3#0
