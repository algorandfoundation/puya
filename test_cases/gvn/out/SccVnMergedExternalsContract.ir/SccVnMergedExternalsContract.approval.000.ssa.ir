subroutine test_cases.gvn.scc_vn_merged_externals.alternating_with_commutative_inits(a: uint64, b: uint64, n: uint64) -> uint64:
    block@0: // L22
        let tmp%0#0: uint64 = (| a#0 b#0)
        let e1#0: uint64 = tmp%0#0
        let tmp%1#0: uint64 = (| b#0 a#0)
        let e2#0: uint64 = tmp%1#0
        let x#0: uint64 = e1#0
        let y#0: uint64 = e2#0
        let s#0: uint64 = 0u
        (assert 1u) // Step cannot be zero
        let value_internal%0#0: uint64 = 0u
        goto block@1
    block@1: // for_header_L29
        let value_internal%0#1: uint64 = φ(value_internal%0#0 <- block@0, value_internal%0#2 <- block@3)
        let y#1: uint64 = φ(y#0 <- block@0, y#2 <- block@3)
        let x#1: uint64 = φ(x#0 <- block@0, x#2 <- block@3)
        let s#1: uint64 = φ(s#0 <- block@0, s#2 <- block@3)
        let continue_looping%0#0: bool = (< value_internal%0#1 n#0)
        goto continue_looping%0#0 ? block@2 : block@4
    block@2: // for_body_L30
        let i#0: uint64 = value_internal%0#1
        let x#2: uint64 = y#1
        let y#2: uint64 = x#1
        let tmp%2#0: uint64 = (+ s#1 i#0)
        let s#2: uint64 = tmp%2#0
        goto block@3
    block@3: // for_footer_L29
        let value_internal%0#2: uint64 = (+ value_internal%0#1 1u)
        goto block@1
    block@4: // after_for_L29
        let tmp%3#0: uint64 = (+ x#1 y#1)
        let tmp%4#0: uint64 = (+ tmp%3#0 s#1)
        return tmp%4#0

subroutine test_cases.gvn.scc_vn_merged_externals.SccVnMergedExternalsContract.__puya_arc4_router__() -> bool:
    block@0: // L4
        let tmp%0#0: uint64 = (txn NumAppArgs)
        let tmp%1#0: bool = (!= tmp%0#0 0u)
        goto tmp%1#0 ? block@1 : block@4
    block@1: // abi_routing_L4
        let tmp%2#0: bytes = (txna ApplicationArgs 0)
        switch tmp%2#0 {method "test_commutative_externals(uint64,uint64,uint64)uint64" => block@2, * => block@3}
    block@2: // test_commutative_externals_route_L17
        let tmp%3#0: uint64 = (txn OnCompletion)
        let tmp%4#0: bool = (== tmp%3#0 NoOp)
        let tmp%5#0: uint64 = (txn ApplicationID)
        let tmp%6#0: bool = (!= tmp%5#0 0u)
