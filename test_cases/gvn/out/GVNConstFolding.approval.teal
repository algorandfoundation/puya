// test_cases.gvn.const_folding.test_setbyte(selector: uint64) -> void:
test_setbyte:
    // gvn/const_folding.py:12-13
    // @subroutine(inline=False)
    // def test_setbyte(selector: bool) -> None:
    proto 1 0
    retsub


// test_cases.gvn.const_folding.test_uint64_mod(x: uint64, selector: uint64) -> void:
test_uint64_mod:
    // gvn/const_folding.py:27-28
    // @subroutine(inline=False)
    // def test_uint64_mod(x: UInt64, selector: bool) -> None:
    proto 2 0
    // gvn/const_folding.py:29-30
    // # simple case — collapses in intrinsic_simplifier
    // assert x % 1 == 0
    frame_dig -2
    intc_0 // 1
    %
    !
    assert
    // gvn/const_folding.py:32-34
    // # demonstrate GVN ability to handle larger constants
    // # and also punch through Phi nodes
    // if selector:
    frame_dig -1
    bz test_uint64_mod_else_body@2
    // gvn/const_folding.py:35
    // one = op.btoi((op.bzero(65) + b"\x01")[-10:])
    intc_1 // 65
    bzero
    bytec_0 // 0x01
    concat
    substring 56 66
    btoi

test_uint64_mod_after_if_else@3:
    // gvn/const_folding.py:38
    // assert x % one == 0
    frame_dig -2
    swap
    %
    !
    assert
    retsub

test_uint64_mod_else_body@2:
    // gvn/const_folding.py:37
    // one = op.btoi((op.bzero(66) + b"\x01")[-10:])
    intc_2 // 66
    bzero
    bytec_0 // 0x01
    concat
    substring 57 67
    btoi
    b test_uint64_mod_after_if_else@3


// test_cases.gvn.const_folding.test_biguint_mod(x: bytes, selector: uint64) -> void:
test_biguint_mod:
    // gvn/const_folding.py:41-42
    // @subroutine(inline=False)
    // def test_biguint_mod(x: BigUInt, selector: bool) -> None:
    proto 2 0
    // gvn/const_folding.py:43-44
    // # simple case — collapses in intrinsic_simplifier
    // assert x % 1 == 0
    frame_dig -2
    bytec_0 // 0x01
    b%
    bytec_1 // 0x
    b==
    assert
    // gvn/const_folding.py:46-48
    // # demonstrate GVN ability to handle larger constants
    // # and also punch through Phi nodes
    // if selector:
    frame_dig -1
    bz test_biguint_mod_else_body@2
    // gvn/const_folding.py:49
    // one = (op.bzero(65) + b"\x01")[-10:]
    intc_1 // 65
    bzero
    bytec_0 // 0x01
    concat
    substring 56 66

test_biguint_mod_after_if_else@3:
    // gvn/const_folding.py:52
    // assert x % BigUInt.from_bytes(one) == 0
    frame_dig -2
    swap
    b%
    bytec_1 // 0x
    b==
    assert
    retsub

test_biguint_mod_else_body@2:
    // gvn/const_folding.py:51
    // one = (op.bzero(66) + b"\x01")[-10:]
    intc_2 // 66
    bzero
    bytec_0 // 0x01
    concat
    substring 57 67
    b test_biguint_mod_after_if_else@3


// test_cases.gvn.const_folding.GVNConstFolding.entry[routing]() -> void:
entry:
    // gvn/const_folding.py:7
    // test_setbyte(True)
    intc_0 // 1
    callsub test_setbyte
    // gvn/const_folding.py:8
    // test_uint64_mod(UInt64(42), False)
    pushints 42 0
    callsub test_uint64_mod
    // gvn/const_folding.py:9
    // test_biguint_mod(BigUInt(42**64), True)
    pushbytes 0x0227eb7da8f7a843ac592cb594e3b9ef0876d3dee6e243fe9763733a81bb74a9b45833010000000000000000
    intc_0 // 1
    callsub test_biguint_mod
    // gvn/const_folding.py:5
    // @public
    intc_0 // 1
    return
