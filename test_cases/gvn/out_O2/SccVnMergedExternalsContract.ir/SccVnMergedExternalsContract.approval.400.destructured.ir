        let tmp%4#1: bytes = (txna ApplicationArgs 3)
        let len%2#0: uint64 = (len tmp%4#1)
        let eq%2#0: bool = (== len%2#0 8u)
        (assert eq%2#0) // invalid number of bytes for arc4.uint64
        let n#0: uint64 = (btoi tmp%4#1)
        let tmp%0#1: uint64 = test_cases.gvn.scc_vn_merged_externals.alternating_with_commutative_inits(a#0, b#0, n#0)
        let aggregate%val_as_bytes%0#0: bytes[8] = (itob tmp%0#1)
        let tmp%8#1: bytes = (concat 0x151f7c75 aggregate%val_as_bytes%0#0)
        (log tmp%8#1)
        exit 1u
    block@4: // switch_case_next_L4
