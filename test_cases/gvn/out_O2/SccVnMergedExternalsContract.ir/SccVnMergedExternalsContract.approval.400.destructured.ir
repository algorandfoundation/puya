subroutine test_cases.gvn.scc_vn_merged_externals.alternating_with_commutative_inits(a: uint64, b: uint64, n: uint64) -> uint64:
    block@0: // L22
        let e1#0: uint64 = (| a#0 b#0)
        let s#0: uint64 = 0u
        let value_internal%0#0: uint64 = 0u
        let i#0: uint64 = value_internal%0#0
        goto block@1
    block@1: // for_header_L29
        let continue_looping%0#0: bool = (< i#0 n#0)
        goto continue_looping%0#0 ? block@2 : block@4
    block@2: // for_body_L30
        let s#0: uint64 = (+ s#0 i#0)
        let value_internal%0#0: uint64 = (+ i#0 1u)
        let i#0: uint64 = value_internal%0#0
        goto block@1
    block@4: // after_for_L29
        let tmp%3#0: uint64 = (+ e1#0 e1#0)
        let tmp%4#0: uint64 = (+ tmp%3#0 s#0)
        return tmp%4#0