#pragma version 11
#pragma typetrack false

// algopy.arc4.ARC4Contract.approval_program() -> uint64:
main:
    intcblock 8 1 0
    txn NumAppArgs
    bz main___algopy_default_create@5
    pushbytes 0x0335fcc0 // method "test_alternating(uint64,uint64,uint64)uint64"
    txna ApplicationArgs 0
    match main_test_alternating_route@3
    err

main_test_alternating_route@3:
    txn OnCompletion
    !
    txn ApplicationID
    &&
    assert
    pushbytes 0x151f7c75
    txna ApplicationArgs 1
    dup
    len
    intc_0 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    txna ApplicationArgs 2
    dup
    len
    intc_0 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    txna ApplicationArgs 3
    dup
    len
    intc_0 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    callsub alternating
    itob
    concat
    log
    intc_1 // 1
    return

main___algopy_default_create@5:
    txn OnCompletion
    !
    txn ApplicationID
    !
    &&
    return


// test_cases.gvn.scc_two_externals.alternating(a: uint64, b: uint64, n: uint64) -> uint64:
alternating:
    proto 3 1
    intc_2 // 0
    frame_dig -3
    frame_dig -2
    intc_2 // 0

alternating_for_header@1:
    frame_dig 3
    frame_dig -1
    <
    bz alternating_after_for@4
    frame_dig 0
    frame_dig 3
    dup
    cover 2
    +
    frame_bury 0
    intc_1 // 1
    +
    frame_bury 3
    frame_dig 1
    frame_dig 2
    frame_bury 1
    frame_bury 2
    b alternating_for_header@1

alternating_after_for@4:
    frame_dig 1
    frame_dig 2
    +
    frame_dig 0
    +
    frame_bury 0
    retsub
