#pragma version 11
#pragma typetrack false

// algopy.arc4.ARC4Contract.approval_program() -> uint64:
main:
    intcblock 8 1
    txn NumAppArgs
    bz main___algopy_default_create@5
    pushbytes 0xc2c1c9eb // method "test_commutative_externals(uint64,uint64,uint64)uint64"
    txna ApplicationArgs 0
    match main_test_commutative_externals_route@3
    err

main_test_commutative_externals_route@3:
    txn OnCompletion
    !
    txn ApplicationID
    &&
    assert
    txna ApplicationArgs 1
    dup
    len
    intc_0 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    txna ApplicationArgs 2
    dup
    len
    intc_0 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    txna ApplicationArgs 3
    dup
    len
    intc_0 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    callsub alternating_with_commutative_inits
    itob
    pushbytes 0x151f7c75
    swap
    concat
    log
    intc_1 // 1
    return

main___algopy_default_create@5:
    txn OnCompletion
    !
    txn ApplicationID
    !
    &&
    return


// test_cases.gvn.scc_vn_merged_externals.alternating_with_commutative_inits(a: uint64, b: uint64, n: uint64) -> uint64:
alternating_with_commutative_inits:
    proto 3 1
    frame_dig -3
    frame_dig -2
    |
    pushint 0
    dup

alternating_with_commutative_inits_for_header@1:
    frame_dig 2
    frame_dig -1
    <
    bz alternating_with_commutative_inits_after_for@4
    frame_dig 1
    frame_dig 2
    dup
    cover 2
    +
    frame_bury 1
    intc_1 // 1
    +
    frame_bury 2
    b alternating_with_commutative_inits_for_header@1

alternating_with_commutative_inits_after_for@4:
    frame_dig 0
    dup
    +
    frame_dig 1
    +
    frame_bury 0
    retsub
