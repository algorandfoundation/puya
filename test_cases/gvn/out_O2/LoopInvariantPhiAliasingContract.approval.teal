#pragma version 11
#pragma typetrack false

// algopy.arc4.ARC4Contract.approval_program() -> uint64:
main:
    intcblock 8 1
    txn NumAppArgs
    bz main___algopy_default_create@5
    pushbytes 0x34384ab9 // method "run(uint64,uint64)uint64"
    txna ApplicationArgs 0
    match main_run_route@3
    err

main_run_route@3:
    txn OnCompletion
    !
    txn ApplicationID
    &&
    assert
    txna ApplicationArgs 1
    dup
    len
    intc_0 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    txna ApplicationArgs 2
    dup
    len
    intc_0 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    callsub loop_invariant_phi_aliasing
    itob
    pushbytes 0x151f7c75
    swap
    concat
    log
    intc_1 // 1
    return

main___algopy_default_create@5:
    txn OnCompletion
    !
    txn ApplicationID
    !
    &&
    return


// test_cases.gvn.loop_invariant_phi_aliasing.loop_invariant_phi_aliasing(x: uint64, y: uint64) -> uint64:
loop_invariant_phi_aliasing:
    proto 2 1
    frame_dig -2
    pushint 0

loop_invariant_phi_aliasing_for_header@1:
    frame_dig 1
    pushint 10
    <
    bz loop_invariant_phi_aliasing_after_for@4
    frame_dig 0
    frame_dig -1
    +
    frame_dig -2
    frame_dig -1
    +
    +
    frame_bury 0
    frame_dig 1
    intc_1 // 1
    +
    frame_bury 1
    b loop_invariant_phi_aliasing_for_header@1

loop_invariant_phi_aliasing_after_for@4:
    retsub
