// algopy.arc4.ARC4Contract.approval_program() -> uint64:
main:
    intcblock 1 0
    txn NumAppArgs
    bz main___algopy_default_create@5
    pushbytes 0xa217b970 // method "test_deep_nesting(uint64)uint64"
    txna ApplicationArgs 0
    match main_test_deep_nesting_route@3
    err

main_test_deep_nesting_route@3:
    txn OnCompletion
    !
    txn ApplicationID
    &&
    assert
    txna ApplicationArgs 1
    dup
    len
    pushint 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    callsub deep_nested_accumulator
    itob
    pushbytes 0x151f7c75
    swap
    concat
    log
    intc_0 // 1
    return

main___algopy_default_create@5:
    txn OnCompletion
    !
    txn ApplicationID
    !
    &&
    return


