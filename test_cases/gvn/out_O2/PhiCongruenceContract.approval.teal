main_call_test_cross_assignment_route@5:
    txna ApplicationArgs 1
    dup
    len
    intc_1 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    callsub test_cross_assignment
    itob
    bytec_0 // 0x151f7c75
    swap
    concat
