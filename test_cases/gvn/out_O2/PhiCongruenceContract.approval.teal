#pragma version 11
#pragma typetrack false

// algopy.arc4.ARC4Contract.approval_program() -> uint64:
main:
    intcblock 1 8 0
    bytecblock 0x151f7c75
    txn NumAppArgs
    bz main___algopy_default_create@11
    txn OnCompletion
    !
    assert
    txn ApplicationID
    assert
    pushbytess 0x55ba48e6 0x68b563af 0x742aaa47 0x8977ab20 // method "call_test_redundant_phi(uint64,uint64)uint64", method "call_test_cross_assignment(uint64)uint64", method "call_test_triple_cycle(uint64)uint64", method "call_test_replacement_chain(uint64)uint64"
    txna ApplicationArgs 0
    match main_call_test_redundant_phi_route@4 main_call_test_cross_assignment_route@5 main_call_test_triple_cycle_route@6 main_call_test_replacement_chain_route@7
    err

main_call_test_replacement_chain_route@7:
    txna ApplicationArgs 1
    dup
    len
    intc_1 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    callsub test_replacement_chain
    itob
    bytec_0 // 0x151f7c75
    swap
    concat
    log
    intc_0 // 1
    return

main_call_test_triple_cycle_route@6:
