#pragma version 11
#pragma typetrack false

// algopy.arc4.ARC4Contract.approval_program() -> uint64:
main:
    txn NumAppArgs
    bz main___algopy_default_create@5
    pushbytes 0x468f60d0 // method "entry()void"
    txna ApplicationArgs 0
    match main_entry_route@3
    err

main_entry_route@3:
    txn OnCompletion
    !
    txn ApplicationID
    &&
    assert
    pushint 1
    callsub test_setbyte
    pushints 42 0
    callsub test_uint64_mod
    pushbytes 0x0227eb7da8f7a843ac592cb594e3b9ef0876d3dee6e243fe9763733a81bb74a9b45833010000000000000000
    pushint 1
    callsub test_biguint_mod
    pushint 1
    return

main___algopy_default_create@5:
    txn OnCompletion
    !
    txn ApplicationID
    !
    &&
    return


// test_cases.gvn.const_folding.test_setbyte(selector: uint64) -> void:
test_setbyte:
    proto 1 0
    retsub


// test_cases.gvn.const_folding.test_uint64_mod(x: uint64, selector: uint64) -> void:
test_uint64_mod:
    proto 2 0
    retsub


// test_cases.gvn.const_folding.test_biguint_mod(x: bytes, selector: uint64) -> void:
test_biguint_mod:
    proto 2 0
    retsub
