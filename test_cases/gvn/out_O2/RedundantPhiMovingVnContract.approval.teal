#pragma version 11
#pragma typetrack false

// algopy.arc4.ARC4Contract.approval_program() -> uint64:
main:
    intcblock 1 8 0
    txn NumAppArgs
    bz main___algopy_default_create@5
    pushbytes 0xc8372713 // method "run(uint64,uint64,bool)uint64"
    txna ApplicationArgs 0
    match main_run_route@3
    err

main_run_route@3:
    txn OnCompletion
    !
    txn ApplicationID
    &&
    assert
    txna ApplicationArgs 1
    dup
    len
    intc_1 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    txna ApplicationArgs 2
    dup
    len
    intc_1 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    txna ApplicationArgs 3
    dup
    len
    intc_0 // 1
    ==
    assert // invalid number of bytes for arc4.bool
    intc_2 // 0
    getbit
    callsub redundant_phi_moving_vn
    itob
    pushbytes 0x151f7c75
    swap
    concat
    log
    intc_0 // 1
    return

main___algopy_default_create@5:
    txn OnCompletion
    !
    txn ApplicationID
    !
    &&
    return


// test_cases.gvn.redundant_phi_moving_vn.redundant_phi_moving_vn(n: uint64, y: uint64, cond: uint64) -> uint64:
redundant_phi_moving_vn:
    proto 3 1
    intc_2 // 0
    dup

redundant_phi_moving_vn_while_top@1:
    frame_dig 1
    frame_dig -3
    <
    bz redundant_phi_moving_vn_after_while@6
    frame_dig 0
    frame_dig -2
    +
    intc_0 // 1
    +
    frame_bury 0
    frame_dig 1
    intc_0 // 1
    +
    frame_bury 1
    b redundant_phi_moving_vn_while_top@1

redundant_phi_moving_vn_after_while@6:
    retsub
