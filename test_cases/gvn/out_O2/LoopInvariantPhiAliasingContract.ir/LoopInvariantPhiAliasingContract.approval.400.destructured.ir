        goto continue_looping%0#0 ? block@2 : block@4
    block@2: // for_body_L38
        let a#0: uint64 = (+ z#1 y#0)
        let z#1: uint64 = (+ a#0 a#0)
        let value_internal%0#0: uint64 = (+ _i#0 1u)
        let _i#0: uint64 = value_internal%0#0
