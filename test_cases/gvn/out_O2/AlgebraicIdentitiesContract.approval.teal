#pragma version 11
#pragma typetrack false

// test_cases.gvn.algebraic_identities.AlgebraicIdentitiesContract.approval_program() -> uint64:
main:
    intcblock 10 1 42
    bytecblock 0x2a 0x01
    bytec_0 // 0x2a
    intc_2 // 42
    callsub test_self_sub
    intc_2 // 42
    callsub test_self_bitwise
    bytec_0 // 0x2a
    intc_1 // 1
    callsub test_one_const
    bytec_0 // 0x2a
    pushint 0
    callsub test_one_const
    txn NumAppArgs
    dup
    intc_1 // 1
    +
    dup2
    callsub test_uint64_swaps
    bytec_1 // 0x01
    pushbytes 0x02
    callsub test_biguint_swaps
    dup2
    callsub test_uint64_negated
    dig 1
    itob
    dig 1
    itob
    dup2
    callsub test_biguint_negated
    uncover 3
    uncover 3
    callsub test_uint64_double_negated
    callsub test_biguint_double_negated
    intc_1 // 1
    return


