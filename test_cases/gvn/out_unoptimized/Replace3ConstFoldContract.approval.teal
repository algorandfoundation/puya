#pragma version 11
#pragma typetrack false

// test_cases.gvn.replace3_const_fold.Replace3ConstFoldContract.approval_program() -> uint64:
main:
    intcblock 1 0 256
    b main_block@0

main_block@0:
    // gvn/replace3_const_fold.py:15
    // test_large_index()
