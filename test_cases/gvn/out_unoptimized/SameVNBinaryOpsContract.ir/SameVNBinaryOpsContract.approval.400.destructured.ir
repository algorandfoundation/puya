main test_cases.gvn.same_vn_binary_ops.SameVNBinaryOpsContract.approval_program:
    block@0: // L14
        test_cases.gvn.same_vn_binary_ops.test_self_sub(42b)
        test_cases.gvn.same_vn_binary_ops.test_self_bitwise(42u)
        return 1u

subroutine test_cases.gvn.same_vn_binary_ops.test_self_sub(x: biguint) -> void:
    block@0: // L23
        let tmp%0#0: biguint = (b- x#0 x#0)
        let tmp%1#0: bool = (b== tmp%0#0 0b)
        (assert tmp%1#0)
        return 

subroutine test_cases.gvn.same_vn_binary_ops.test_self_bitwise(y: uint64) -> void:
    block@0: // L29
        let tmp%0#0: uint64 = (& y#0 y#0)
        let tmp%1#0: bool = (== tmp%0#0 y#0)
        (assert tmp%1#0)
        let tmp%2#0: uint64 = (| y#0 y#0)
        let tmp%3#0: bool = (== tmp%2#0 y#0)
        (assert tmp%3#0)
        return 