subroutine test_cases.gvn.const_folding.test_setbyte(selector: bool) -> void:
    block@0: // L10
        let tmp%0#0: bytes = (setbyte 0x4142 0u 90u)
        let tmp%1#0: bool = (== tmp%0#0 0x5a42)
        (assert tmp%1#0)
        let tmp%2#0: bytes = (setbyte 0x4142 1u 90u)
