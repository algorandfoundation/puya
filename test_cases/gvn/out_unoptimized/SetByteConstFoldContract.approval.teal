// test_cases.gvn.setbyte_const_fold.SetByteConstFoldContract.approval_program() -> uint64:
main:
    intcblock 0 1 90
    bytecblock 0x4142
    b main_block@0

main_block@0:
    // gvn/setbyte_const_fold.py:13
    // test_direct()
