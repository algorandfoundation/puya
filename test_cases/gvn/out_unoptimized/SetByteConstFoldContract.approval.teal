// test_cases.gvn.setbyte_const_fold.test_direct() -> void:
test_direct:
    b test_direct_block@0

test_direct_block@0:
    // gvn/setbyte_const_fold.py:23-24
    // # const args — collapses in intrinsic_simplifier
    // assert op.setbyte(Bytes(b"AB"), 0, 90) == Bytes(b"ZB")  # 90 == ord('Z')
    bytec_0 // 0x4142
    intc_0 // 0
    intc_2 // 90
    setbyte
    pushbytes 0x5a42
    ==
    assert
    // gvn/setbyte_const_fold.py:25
    // assert op.setbyte(Bytes(b"AB"), 1, 90) == Bytes(b"AZ")
