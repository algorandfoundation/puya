// test_cases.gvn.setbyte_const_fold.test_through_phi(selector: uint64) -> void:
test_through_phi:
    // gvn/setbyte_const_fold.py:28-29
    // @subroutine(inline=False)
    // def test_through_phi(selector: UInt64) -> None:
    proto 1 0
    b test_through_phi_block@0

test_through_phi_block@0:
    // gvn/setbyte_const_fold.py:30-32
    // # selector flows through a phi but both arms produce the same const-foldable arg;
    // # only GVN sees the equivalence and folds the setbyte.
    // if selector:
    frame_dig -1
    intc_0 // 0
    !=
    bz test_through_phi_else_body@2
    b test_through_phi_if_body@1

test_through_phi_if_body@1:
    b test_through_phi_after_if_else@3

test_through_phi_after_if_else@3:
    // gvn/setbyte_const_fold.py:33
