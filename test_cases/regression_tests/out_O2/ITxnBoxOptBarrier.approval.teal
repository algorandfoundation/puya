#pragma version 13
#pragma typetrack false
#pragma autosalt false

// test_cases.regression_tests.itxn_box_optimization_barrier.ITxnBoxOptBarrier.approval_program() -> uint64:
main:
    txna ApplicationArgs 0
    txna ApplicationArgs 1
    dig 1
    box_get
    pop
    log
    itxn_begin
    itxn_submit
    dig 1
    box_get
    assert // check Box exists
    log
    txn ApplicationID
    dig 1
    uncover 2
    app_box_put
    box_get
    pop
    log
    pushint 1
    return
