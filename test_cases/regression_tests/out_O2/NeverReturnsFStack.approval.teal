#pragma version 11
#pragma typetrack false

// algopy.arc4.ARC4Contract.approval_program() -> uint64:
main:
    pushbytes ""
    txn NumAppArgs
    bz main___algopy_default_create@5
    pushbytes 0x3f27f4a4 // method "method()uint64"
    txna ApplicationArgs 0
    match main_method_route@3
    err

main_method_route@3:
    txn OnCompletion
    !
    txn ApplicationID
    &&
    assert
    pushint 1
    bury 1
    txn NumAppArgs
    bz main_after_if_else@8
    pushint 2
    bury 1

main_after_if_else@8:
    txn NumAppArgs
    pushint 0
    dup

main_for_header@9:
    dup
    dig 3
    <
    bz main_after_for@13
    dig 3
    dig 1
    dup
    cover 2
    +
    bury 5
    bnz main_after_if_else@12
    swap
    pushint 1
    +
    swap

main_after_if_else@12:
    pushint 1
    +
    b main_for_header@9

main_after_for@13:
    pop
    itob
    pushbytes "you won't see this"
    swap
    concat
    log
    err

main___algopy_default_create@5:
    txn OnCompletion
    !
    txn ApplicationID
    !
    &&
    return
