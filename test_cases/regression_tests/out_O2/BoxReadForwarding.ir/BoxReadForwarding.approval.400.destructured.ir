        let (m#0: bytes, aggregate%box_get%11#0: bool) = (box_get 0x61)
        (assert aggregate%box_get%11#0) // check self.a exists
        let new_items_bytes#0: bytes = (itob 9u)
        let arr_len_bytes#0: bytes = (box_extract 0x61 0u 2u)
