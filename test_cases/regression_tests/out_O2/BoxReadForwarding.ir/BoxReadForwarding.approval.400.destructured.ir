        let new_arr_len#0: bytes = ((extract 6 2) value_bytes#0)
        (box_replace 0x61 0u new_arr_len#0)
        let tmp%8#0: uint64 = (* arr_len#0 8u)
        let end_of_array_offset#0: uint64 = (+ 2u tmp%8#0)
