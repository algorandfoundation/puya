main test_cases.regression_tests.unobserved_write_stale_read.UnobservedWriteStaleRead.approval_program:
    block@0: // L15
        let tmp%0#0: bool = (txn ApplicationID)
        goto tmp%0#0 ? block@2 : block@1
    block@1: // call __init___L1
        (app_global_put "stored" 0u)
        goto block@2
    block@2: // after_if_else_L1
        (app_global_put "stored" 11u)
        let (maybe_value%0#0: uint64, maybe_exists%0#0: bool) = (11u, 1u)
        (assert maybe_exists%0#0) // check self.stored exists
        let tmp%1#0: bool = (== maybe_value%0#0 11u)
        (assert tmp%1#0) // stored should be 11
        return 1u