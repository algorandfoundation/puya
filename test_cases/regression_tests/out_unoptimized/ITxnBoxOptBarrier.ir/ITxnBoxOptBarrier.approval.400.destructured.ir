main test_cases.regression_tests.itxn_box_optimization_barrier.ITxnBoxOptBarrier.approval_program:
    block@0: // L12
        let tmp%0#0: bytes = ((txnas ApplicationArgs) 0u)
        let arg0#0: bytes = tmp%0#0
        let tmp%1#0: bytes = ((txnas ApplicationArgs) 1u)
        let arg1#0: bytes = tmp%1#0
        let (tmp%2#0: bytes, tmp%3#0: bool) = (box_get arg0#0)
        let val#0: bytes = tmp%2#0
        (log val#0)
        itxn_begin
        itxn_submit
        let (aggregate%box_get%0#0: bytes, aggregate%box_get%1#0: bool) = (box_get arg0#0)
        (assert aggregate%box_get%1#0) // check Box exists
        let storage_value%0#0: bytes = aggregate%box_get%0#0
        (log storage_value%0#0)
        let tmp%4#0: uint64 = (txn ApplicationID)
        (app_box_put tmp%4#0 arg1#0 arg1#0)
        let (aggregate%box_get%2#0: bytes, aggregate%box_get%3#0: bool) = (box_get arg0#0)
        (assert aggregate%box_get%3#0) // check Box exists
        let storage_value%1#0: bytes = aggregate%box_get%2#0
        (log storage_value%1#0)
        return 1u